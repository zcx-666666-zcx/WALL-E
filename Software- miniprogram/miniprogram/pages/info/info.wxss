/* pages/info/info.wxss */

.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 380rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 280rpx; height: 280rpx;
  top: 160rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 188rpx 40rpx 32rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub   { font-size: 22rpx; color: rgba(255,255,255,0.65); }

/* Info list */
.info-list {
  position: relative; z-index: 10;
  display: flex; flex-direction: column;
  gap: 14rpx; padding: 0 32rpx;
}

.info-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
  overflow: hidden;
  transition: box-shadow 0.2s ease;
}
.info-card:active { box-shadow: 0 2rpx 8rpx rgba(200,90,50,0.08); }

.info-card-header {
  display: flex; flex-direction: row; align-items: center;
  gap: 18rpx; padding: 24rpx 24rpx;
}

.info-card-icon-wrap {
  width: 60rpx; height: 60rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.info-card-icon { font-size: 30rpx; }

.info-card-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.info-card-title { font-size: 28rpx; font-weight: 700; color: #2A1408; }
.info-card-hint  { font-size: 20rpx; color: #C4A898; }

.info-card-toggle {
  font-size: 22rpx; color: #C4A898;
  transition: transform 0.3s ease;
}
.toggle-open { transform: rotate(180deg); color: #FF7040; }

.info-card-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s ease;
}
.content-open {
  max-height: 300rpx;
  padding: 0 24rpx 24rpx;
}
.info-card-desc {
  font-size: 24rpx; color: #6A4030;
  line-height: 1.8;
  display: block;
}
