/* pages/set/set.wxss */

.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 380rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 280rpx; height: 280rpx;
  top: 160rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 188rpx 40rpx 32rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub   { font-size: 22rpx; color: rgba(255,255,255,0.65); }

.section-label {
  position: relative; z-index: 10;
  font-size: 24rpx; font-weight: 700; color: #B09080;
  letter-spacing: 2rpx; padding: 12rpx 40rpx 16rpx;
  text-transform: uppercase;
}

.setting-list {
  position: relative; z-index: 10;
  display: flex; flex-direction: column;
  gap: 14rpx; padding: 0 32rpx;
}

.setting-card {
  display: flex; flex-direction: row; align-items: center;
  gap: 18rpx; padding: 26rpx 24rpx;
  background: #FFFFFF;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.setting-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(200,90,50,0.08);
}

.setting-icon-wrap {
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.icon-speak  { background: linear-gradient(135deg, #E8F5FF, #D0E8FF); }
.icon-event  { background: linear-gradient(135deg, #EDF8F0, #D0F0DC); }
.icon-ai     { background: linear-gradient(135deg, #FFF5E8, #FFECD0); }
.icon-camera { background: linear-gradient(135deg, #FFF0F5, #FFD6E4); }
.icon-connect{ background: linear-gradient(135deg, #F8F0FF, #E8D8FF); }
.setting-icon { font-size: 30rpx; }

.setting-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.setting-title { font-size: 28rpx; font-weight: 700; color: #2A1408; }
.setting-desc  { font-size: 22rpx; color: #B09080; }

/* Toggle switch */
.setting-toggle {
  width: 88rpx; height: 48rpx;
  border-radius: 24rpx;
  display: flex; align-items: center;
  padding: 0 5rpx;
  transition: background 0.3s ease;
  flex-shrink: 0;
}
.toggle-on  { background: #4CAF84; }
.toggle-off { background: #D0C8C0; }

.toggle-knob {
  width: 38rpx; height: 38rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
  transition: transform 0.3s ease;
}
.toggle-on  .toggle-knob { transform: translateX(40rpx); }
.toggle-off .toggle-knob { transform: translateX(0); }
