/* pages/healthy/healthy.wxss */

/* ══ 根容器 ══ */
.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

/* ══ 顶部暖色背景 ══ */
.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 380rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 280rpx; height: 280rpx;
  top: 180rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

/* ══ 顶部标题 ══ */
.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 88rpx 40rpx 32rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub { font-size: 22rpx; color: rgba(255,255,255,0.65); }

.device-chip {
  display: flex; flex-direction: row; align-items: center; gap: 8rpx;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 100rpx; padding: 10rpx 22rpx;
}
.device-chip-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #A8FFCA;
  display: inline-block;
}
.device-chip-text { font-size: 22rpx; color: rgba(255,255,255,0.9); max-width: 180rpx; overflow: hidden; }

/* ══ 分区标签 ══ */
.section-label {
  position: relative; z-index: 10;
  font-size: 24rpx; font-weight: 700; color: #B09080;
  letter-spacing: 2rpx; padding: 28rpx 40rpx 12rpx;
  text-transform: uppercase;
}

/* ══ 四格指标网格 ══ */
.cards-grid {
  position: relative; z-index: 10;
  display: flex; flex-wrap: wrap;
  gap: 16rpx; padding: 0 32rpx;
}

/* 指标卡片 */
.metric-card {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 22rpx;
  box-sizing: border-box;
  border-top: 4rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.07);
  position: relative; overflow: hidden;
}
/* 顶部彩色条 */
.card-normal { border-top-color: #4CAF84; }
.card-warn   { border-top-color: #FFB020; }
.card-danger { border-top-color: #FF5A36; }
.card-idle   { border-top-color: rgba(200,160,130,0.3); }

.metric-top {
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.metric-icon-wrap {
  width: 60rpx; height: 60rpx; border-radius: 16rpx;
  background: #FFF5F0;
  display: flex; align-items: center; justify-content: center;
}
.metric-icon { font-size: 30rpx; }

.metric-status-badge {
  display: flex; flex-direction: row; align-items: center; gap: 6rpx;
  padding: 5rpx 14rpx; border-radius: 100rpx;
  background: rgba(200,140,100,0.1);
}
.card-normal .metric-status-badge { background: rgba(76,175,132,0.12); }
.card-warn   .metric-status-badge { background: rgba(255,176,32,0.12); }
.card-danger .metric-status-badge { background: rgba(255,90,54,0.12); }

.status-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #C4A898;
}
.card-normal .status-dot { background: #4CAF84; }
.card-warn   .status-dot { background: #FFB020; }
.card-danger .status-dot { background: #FF5A36; }

.status-text {
  font-size: 20rpx; font-weight: 600; color: #A09080;
}
.card-normal .status-text { color: #3A8A60; }
.card-warn   .status-text { color: #A07010; }
.card-danger .status-text { color: #C03020; }

.metric-value-row {
  display: flex; flex-direction: row;
  align-items: baseline; gap: 6rpx;
  margin-bottom: 16rpx;
}
.metric-value {
  font-size: 52rpx; font-weight: 800; color: #2A1408; line-height: 1;
}
.metric-unit { font-size: 22rpx; color: #B09080; }

/* 进度条 */
.metric-bar-track {
  height: 6rpx; background: #F0E8E0;
  border-radius: 3rpx; overflow: hidden; margin-bottom: 14rpx;
}
.metric-bar-fill {
  height: 100%; border-radius: 3rpx;
  background: #C4A898; max-width: 100%;
  transition: width 0.4s ease;
}
.card-normal .metric-bar-fill { background: #4CAF84; }
.card-warn   .metric-bar-fill { background: #FFB020; }
.card-danger .metric-bar-fill { background: #FF5A36; }

.metric-footer-row {
  display: flex; flex-direction: row;
  justify-content: space-between; align-items: center;
}
.metric-name  { font-size: 22rpx; font-weight: 600; color: #7A5040; }
.metric-range { font-size: 20rpx; color: #C4A898; }

/* ══ 跌倒检测卡片 ══ */
.fall-card {
  position: relative; z-index: 10;
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(255,160,120,0.15);
  box-shadow: 0 4rpx 20rpx rgba(200,90,50,0.07);
  display: flex; flex-direction: row; gap: 24rpx;
  align-items: flex-start;
}
.fall-danger { border-color: rgba(255,90,54,0.3); background: rgba(255,240,238,0.8); }
.fall-normal { border-color: rgba(76,175,132,0.25); }
.fall-idle   { border-color: rgba(255,176,32,0.2); }

.fall-left { flex: 1; display: flex; flex-direction: column; gap: 14rpx; }

.fall-status-row { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.fall-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 18rpx;
  background: #FFF5F0;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.fall-danger .fall-icon-wrap { background: rgba(255,90,54,0.1); }
.fall-normal .fall-icon-wrap { background: rgba(76,175,132,0.1); }
.fall-icon { font-size: 36rpx; }

.fall-status-info { display: flex; flex-direction: column; gap: 5rpx; }
.fall-status-text { font-size: 30rpx; font-weight: 700; color: #2A1408; }
.fall-danger .fall-status-text { color: #C03020; }
.fall-normal .fall-status-text { color: #2A7050; }
.fall-status-sub { font-size: 21rpx; color: #B09080; }

.fall-desc { font-size: 22rpx; color: #9A7060; line-height: 1.6; }

.fall-image {
  width: 140rpx; height: 110rpx;
  border-radius: 14rpx;
  background: #F0E8E0;
  border: 1rpx solid rgba(255,160,120,0.2);
}

.fall-actions {
  display: flex; flex-direction: column; gap: 12rpx;
  flex-shrink: 0; width: 180rpx;
}
.action-btn {
  width: 180rpx !important;
  height: 72rpx !important;
  font-size: 24rpx !important;
  border-radius: 14rpx !important;
  border: none !important;
  font-weight: 600 !important;
  line-height: 72rpx !important;
  text-align: center !important;
  padding: 0 !important;
  margin: 0 !important;
}
.btn-refresh  { background: #FFF0E8 !important; color: #C06030 !important; }
.btn-alarm    { background: #FF5A36 !important; color: #FFFFFF !important; }
.btn-photo    { background: #FFF5E8 !important; color: #A06020 !important; }

/* ══ 设备管理卡片 ══ */
.device-card {
  position: relative; z-index: 10;
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 20rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
}
.device-card-header {
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  margin-bottom: 20rpx;
}
.device-card-title { font-size: 28rpx; font-weight: 700; color: #3A2010; }

.reload-btn {
  height: 56rpx !important; width: auto !important;
  padding: 0 24rpx !important; margin: 0 !important;
  font-size: 22rpx !important; font-weight: 600 !important;
  background: linear-gradient(90deg, #FF9A76, #FF6040) !important;
  color: white !important; border: none !important;
  border-radius: 28rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(255,96,64,0.28) !important;
  line-height: 56rpx !important;
}

.device-list {
  max-height: 260rpx; margin-bottom: 16rpx;
}
.device-item {
  display: flex; flex-direction: row; align-items: center; gap: 12rpx;
  padding: 18rpx 16rpx; border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #FFF8F5;
  border: 1rpx solid rgba(255,160,120,0.1);
  transition: all 0.18s;
}
.device-item-active {
  background: linear-gradient(90deg, #FFF0E8, #FFE4D4);
  border-color: rgba(255,140,80,0.25);
}
.device-item-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #D0B0A0; flex-shrink: 0;
}
.device-item-active .device-item-dot { background: #FF7040; }
.device-item-name { font-size: 25rpx; color: #6A4030; font-weight: 500; }
.device-item-active .device-item-name { color: #C04020; font-weight: 700; }

.device-empty { font-size: 24rpx; color: #C4A898; text-align: center; padding: 24rpx 0; }

.device-current {
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255,160,120,0.1);
}
.device-current-label { font-size: 22rpx; color: #B09080; }
.device-current-val { font-size: 24rpx; font-weight: 600; color: #5A3020; font-family: monospace; }
