<view class="root">

<image class="bg-image" src="{{image_ip1}}" mode="scaleToFill"></image>
<view class="bg-overlay"></view>
<view class="orb orb-1"></view>
<view class="orb orb-2"></view>

<!-- 顶部品牌 -->
<view class="brand-area">
  <view class="brand-logo">
    <text class="logo-heart">♡</text>
  </view>
  <view class="brand-text">
    <text class="brand-name">智能陪伴</text>
    <text class="brand-sub">机器人管理平台</text>
  </view>
</view>

<!-- 注册卡片 -->
<view class="card">
  <view class="card-header">
    <text class="card-title">创建账号</text>
    <text class="card-sub">填写以下信息完成注册</text>
  </view>

  <!-- 用户名 -->
  <view class="field-group">
    <text class="field-label">用户名</text>
    <view class="field-wrap">
      <text class="field-icon">👤</text>
      <input
        class="field-input"
        type="text"
        placeholder="请设置用户名"
        placeholder-class="field-ph"
        bindinput="nameHandle"
      />
    </view>
  </view>

  <!-- 密码 -->
  <view class="field-group">
    <text class="field-label">密码</text>
    <view class="field-wrap">
      <text class="field-icon">🔒</text>
      <input
        class="field-input"
        type="text"
        password="{{true}}"
        placeholder="请设置密码"
        placeholder-class="field-ph"
        bindinput="passwordHandle"
      />
    </view>
  </view>

  <!-- 确认密码 -->
  <view class="field-group">
    <text class="field-label">确认密码</text>
    <view class="field-wrap {{pwdMatch === 'ok' ? 'field-wrap-ok' : pwdMatch === 'err' ? 'field-wrap-err' : ''}}">
      <text class="field-icon">✅</text>
      <input
        class="field-input"
        type="text"
        password="{{true}}"
        placeholder="请再次输入密码"
        placeholder-class="field-ph"
        bindinput="sureHandle"
      />
    </view>
    <text class="field-hint field-hint-err" wx:if="{{pwdMatch === 'err'}}">两次密码不一致</text>
    <text class="field-hint field-hint-ok" wx:if="{{pwdMatch === 'ok'}}">密码一致 ✓</text>
  </view>

  <!-- 手机号 -->
  <view class="field-group">
    <view class="field-label-row">
      <text class="field-label">手机号码</text>
      <text class="field-label-opt">用于找回密码</text>
    </view>
    <view class="field-wrap">
      <text class="field-icon">📱</text>
      <input
        class="field-input"
        type="number"
        placeholder="请输入手机号码"
        placeholder-class="field-ph"
        bindinput="phone_numberHandle"
      />
    </view>
  </view>

  <!-- 注册按钮 -->
  <view class="btn-primary" bind:tap="GoRegist">
    <text class="btn-primary-text">立即注册</text>
    <text class="btn-arrow">→</text>
  </view>

  <!-- 分割线 -->
  <view class="divider">
    <view class="divider-line"></view>
    <text class="divider-text">已有账号？</text>
    <view class="divider-line"></view>
  </view>

  <!-- 登录入口 -->
  <navigator class="btn-ghost" url="/pages/login/login" hover-class="btn-ghost-hover">
    <text class="btn-ghost-text">返回登录</text>
  </navigator>
</view>

<!-- 特性标签 -->
<view class="tags-row">
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">健康监测</text>
  </view>
  <view class="tag-sep"></view>
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">AI 陪聊</text>
  </view>
  <view class="tag-sep"></view>
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">远程监护</text>
  </view>
</view>

<view class="footer">
  <text class="footer-text">郑州轻工业大学 · 吊炸天团队</text>
</view>

</view>
