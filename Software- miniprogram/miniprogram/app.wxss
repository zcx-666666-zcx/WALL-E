/* ═══════════════════════════════════════════════
   DESIGN TOKENS — Mini-Program Health App
   ═══════════════════════════════════════════════ */

page {
  --color-primary-start: #FF9A76;
  --color-primary-mid: #FF6040;
  --color-primary-end: #E84020;
  --color-primary-gradient: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  --color-primary-btn: linear-gradient(90deg, #FF9A76, #FF5A30);

  --bg-warm: #e9e3df;
  --bg-card: #FFFFFF;
  --bg-card-tinted: #FFF8F5;
  --bg-card-light: #FFFAF7;
  --bg-input: #FFFAF7;
  --bg-overlay: rgba(20, 8, 2, 0.55);

  --text-dark: #2A1408;
  --text-medium: #3A2010;
  --text-body: #5A3020;
  --text-muted: #B09080;
  --text-dim: #C4A898;

  --border-card: rgba(255, 160, 120, 0.12);
  --border-input: rgba(255, 160, 120, 0.25);

  --shadow-card: 0 4rpx 20rpx rgba(200, 90, 50, 0.07);
  --shadow-card-lifted: 0 8rpx 28rpx rgba(200, 90, 50, 0.12);
  --shadow-btn: 0 6rpx 20rpx rgba(255, 96, 64, 0.3);

  --status-normal: #4CAF84;
  --status-warn: #FFB020;
  --status-danger: #FF5A36;

  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 36rpx;
  --radius-round: 100rpx;
}

/* ═══════════════════════════════════════════════
   ANIMATION KEYFRAMES (global)
   ═══════════════════════════════════════════════ */

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes scaleIn {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.85); }
  to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

@keyframes scaleOut {
  from { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  to   { opacity: 0; transform: translate(-50%, -50%) scale(0.85); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.5; transform: scale(1.3); }
}

@keyframes pulseDanger {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 90, 54, 0.5); }
  50%      { box-shadow: 0 0 0 16rpx rgba(255, 90, 54, 0); }
}

@keyframes shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes slideInDown {
  from { opacity: 0; transform: translateY(-60rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes blink {
  0%, 100% { opacity: 0.3; }
  50%      { opacity: 1; }
}

@keyframes valueFlash {
  0%   { color: #FF5A36; transform: scale(1.15); }
  100% { color: inherit; transform: scale(1); }
}

@keyframes ripple {
  to { transform: scale(4); opacity: 0; }
}

/* ═══════════════════════════════════════════════
   ANIMATION UTILITY CLASSES
   ═══════════════════════════════════════════════ */
.anim-fadeInUp { animation: fadeInUp 0.5s ease both; }
.anim-fadeIn   { animation: fadeIn 0.35s ease both; }
.anim-scaleIn  { animation: scaleIn 0.4s ease both; }
.anim-slideInDown { animation: slideInDown 0.4s ease both; }
.anim-pulse    { animation: pulse 2s ease-in-out infinite; }
.anim-pulseDanger { animation: pulseDanger 2s ease-in-out infinite; }
.anim-shimmer {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.anim-delay-1 { animation-delay: 0.05s; }
.anim-delay-2 { animation-delay: 0.10s; }
.anim-delay-3 { animation-delay: 0.15s; }
.anim-delay-4 { animation-delay: 0.20s; }
.anim-delay-5 { animation-delay: 0.25s; }
.anim-delay-6 { animation-delay: 0.30s; }

/* ═══════════════════════════════════════════════
   SHARED PAGE TEMPLATE HELPERS
   ═══════════════════════════════════════════════ */
.page-root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.page-top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 420rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}

.page-orb {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
}
.page-orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.page-orb-2 {
  width: 280rpx; height: 280rpx;
  top: 180rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

.page-header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 88rpx 40rpx 32rpx;
}
.page-header-left { display: flex; flex-direction: column; gap: 6rpx; }
.page-header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.page-header-sub   { font-size: 22rpx; color: rgba(255,255,255,0.65); }

.page-section-label {
  position: relative; z-index: 10;
  font-size: 24rpx; font-weight: 700;
  color: #B09080; letter-spacing: 2rpx;
  padding: 28rpx 40rpx 12rpx;
  text-transform: uppercase;
}

.page-card {
  position: relative; z-index: 10;
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.page-chip {
  display: flex; flex-direction: row; align-items: center; gap: 8rpx;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 100rpx;
  padding: 10rpx 22rpx;
}
.page-chip-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #A8FFCA;
}
.page-chip-text {
  font-size: 22rpx; color: rgba(255,255,255,0.9);
}

/* Primary button */
.btn-primary {
  width: 100%; height: 88rpx;
  background: linear-gradient(90deg, #FF9A76, #FF5A30);
  border-radius: 44rpx;
  display: flex; flex-direction: row;
  align-items: center; justify-content: center; gap: 12rpx;
  box-shadow: 0 10rpx 28rpx rgba(255,90,48,0.38);
  font-size: 30rpx; font-weight: 700; color: white;
  letter-spacing: 3rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-primary:active { transform: scale(0.96); opacity: 0.85; }

/* Ghost button */
.btn-ghost {
  width: 100%; height: 88rpx;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.22);
  border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 600;
  color: rgba(255,255,255,0.85);
  letter-spacing: 3rpx;
  transition: background 0.2s ease;
}
.btn-ghost:active { background: rgba(255,255,255,0.14); }
