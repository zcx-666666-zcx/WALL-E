{
  "compilerOptions": {
    "strictNullChecks": true,
    "noImplicitAny": true,
    "module": "Commonjs",
    "target": "ES6",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "lib": [
      "es6",
      "DOM"
    ],
    "types": ["miniprogram-api-typings", "miniprogram-typings"],
    "strict": true,
    "paths": {
      "@/*": ["miniprogram/*"]
    }
  },
  "include": [
    "miniprogram/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}