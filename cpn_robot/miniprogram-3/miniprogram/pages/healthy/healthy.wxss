/* 🔥 全局页面：和menu页面完全同款背景+底色 */
.page {
  height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  /* 🔥 和menu统一的底色 */
  background: #746e63;
  padding: 30rpx 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* 🔥 全屏背景图样式：和menu完全一致 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  opacity: 0.75;
}

/* 2x2 网格布局：提升层级，在背景图上方 */
.grid-box {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin: 40rpx 10rpx 32rpx 10rpx;
  z-index: 2;
  position: relative;
}

/* 卡片基础样式 */
.card {
  width: calc(50% - 12rpx);
  background: #ffffff;
  border-radius: 10rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border-left: 8rpx solid;
  box-sizing: border-box;
}

/* 卡片状态色 */
.card-normal {
  border-left-color: #00c853;
}
.card-warning {
  border-left-color: #ffab00;
}
.card-danger {
  border-left-color: #ff3d00;
}

/* 卡片头部（图标+标题） */
.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.card-icon {
  font-size: 32rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

/* 卡片数值（核心展示） */
.card-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 20rpx;
}
.value-main {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.value-unit {
  font-size: 24rpx;
  color: #666666;
}

/* 进度条（数据可视化） */
.card-progress {
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 4rpx;
}
.card-normal .progress-bar {
  background: #00c853;
}
.card-warning .progress-bar {
  background: #ffab00;
}
.card-danger .progress-bar {
  background: #ff3d00;
}

/* 正常范围提示 */
.card-range {
  font-size: 22rpx;
  color: #999999;
}

/* 跌倒模块：提升层级，在背景图上方 */
.fall-box {
  margin: 120rpx 0 0 0;
  background: #ffffff;
  padding: 32rpx;
  border-bottom: 2rpx solid rgb(1,1,1);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  z-index: 2;
  position: relative;
}
.fall-left {
  flex: 1;
  padding-right: 24rpx;
}
.fall-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.fall-title-normal {
  color: #00c853;
}
.fall-title-warning {
  color: #ffab00;
}
.fall-title-danger {
  color: #ff3d00;
}
.fall-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 24rpx;
}
.fall-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 5rpx;
  background: #7c7c7c;
  border:  2rpx solid rgb(19, 19, 19);
}
.fall-right {
  width: 250rpx;
  height: 350rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.fall-btn {
  margin: 20rpx 0 10rpx 0;
  height: 80rpx;
  width: 200rpx !important;
  font-size: 26rpx;
  border-radius: 12rpx;
  background: #00c431;
  color: #5a5a5a;
  border: none;
}
.fall-btn-alarm {
  background: #ff3d00;
  color: #ffffff;
}
.fall-btn-request {
  background: #0066cc;
  color: #ffffff;
}

/* 设备模块：提升层级，在背景图上方 */
.device-box {
  background: #ffffff;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 2;
  position: relative;
}
.device-header {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}
.device-content {
  display: flex;
  gap: 24rpx;
}
.device-list {
  width: 30%;
}
.device-item {
  background: #f0f0f0;
  color: #333333;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  text-align: center;
  font-size: 24rpx;
}
.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.device-info text {
  font-size: 26rpx;
  color: #666666;
}
.global-refresh {
  height: 72rpx;
  width: 60%;
  font-size: 26rpx;
  border-radius: 12rpx;
  background: #00c853;
  color: #ffffff;
  border: none;
}