<!--pages/drive/drive.wxml-->
<view class="container1">
  <image class="bg-image" src="{{image_ip}}" mode=""/>
  <view class="UP">
    <text>远程遥控</text>
  </view>
  <view id="connect"><text>设备状态：{{is_connect}}</text></view>

  <view id="vedio"><text>{{vedio_connect}}</text></view>

  <view class="container2">
    <view id="left" 
    bindtouchstart="onButtonPress_left" 
    bindtouchcancel="onButtonRelease_left"></view>
    <view id="right" 
    bindtouchstart="onButtonPress_right" 
    bindtouchcancel="onButtonRelease_right"></view>
    <view id="go" 
    bindtouchstart="onButtonPress_go" 
    bindtouchcancel="onButtonRelease_go"></view>
    <view id="back"
    bindtouchstart="onButtonPress_back" 
    bindtouchcancel="onButtonRelease_back"></view>
    <view id="up"
    bindtouchstart="onButtonPress_up" 
    bindtouchcancel="onButtonRelease_up"></view>
    <view id="down"
    bindtouchstart="onButtonPress_down" 
    bindtouchcancel="onButtonRelease_down"></view>
  </view>


</view>