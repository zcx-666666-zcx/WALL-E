<view class="container1">
  <view class="chat">
    <view id="title">
      测试窗口
    </view>
    <view class="talk" id="talkContent">
      <block wx:for="{{messages}}" wx:key="index">
        <view class="message {{item.type === 'user' ? 'user-message' : 'ai-message'}}">
          <text>{{item.content}}</text>
        </view>
      </block>
    </view>
    <view id="send">
      <textarea 
        id="send_text" 
        name="message" 
        placeholder="请输入消息..." 
        maxlength="500" 
        auto-height 
        value="{{user_message}}"
        bindinput="onInputChange"
        bindconfirm="onConfirm"
      />
      <button id="send_button" form-type="submit" bindtap="onSendTap">发送</button>
    </view>
  </view>

  <view class="set">
    <view id="title_2">调试窗口</view>
    <view id="set_text">
      <form bindsubmit="submitStyle">
        <textarea 
          name="styleConfig" 
          placeholder="请输入你希望的AI聊天风格，例如：请用幽默风趣的方式回答，或者用专业的学术语气..." 
          maxlength="1000" 
          value="{{styleConfig}}"
          bindinput="onStyleConfigChange"
        />
        <button form-type="submit">提交风格设置</button>
      </form>
    </view>
  </view>
</view>