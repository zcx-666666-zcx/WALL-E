.container1 {
  height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  background: #002544;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  opacity: 0.75;
}

#hello {
  width: 84%;
  height: 80rpx;
  margin: 30rpx 4%;
  padding: 0 30rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #2c3e50;
  z-index: 2;
  position: absolute;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  font-weight: 500;
}

/* Container2 样式 */
.container2 {
  z-index: 2;
  position: absolute;
  height: 400rpx;
  width: 720rpx;
  top: 140rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
  background-color: rgb(214, 214, 214);
  opacity: 0.9;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.3);
}

.container2 #element,
.container2 #energy {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.container2 #element navigator {
  padding: 28rpx 48rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  font-size: 40rpx;
  color: #2c3e50;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  font-weight: 500;
  border: 1px solid rgba(255, 255, 255, 0.8);
}

.container2 #element navigator:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  background: rgba(245, 245, 245, 0.95);
}

/* 简洁电量显示 */
#energy {
  position: relative;
  width: 250rpx;
  height: 250rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

#energywatch {
  width: 200rpx;
  height: 200rpx;
  border: 15rpx solid #77c3da;
  border-radius: 50%;
  background: 
    conic-gradient(from 0deg, 
      #00f335 0%, 
      #00f335 calc(var(--energy-percent, 0.8) * 360deg), 
      #868686 calc(var(--energy-percent, 0.2) * 360deg), 
      #868686 360deg);
  position: absolute;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

#energynumber {
  position: absolute;
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
  z-index: 3;
}

/* Container3 样式 */
.container3 {
  z-index: 2;
  position: absolute;
  top: 580rpx;
  left: 40rpx;
  right: 40rpx;
  height: 120rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(222, 241, 241, 0.95);
  border-radius: 20rpx;
  padding: 0 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
}

.container3 view {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  position: relative;
}

.container3 view:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 25%;
  height: 50%;
  width: 4rpx;
  background: #2c3e50;
}

.container3 navigator {
  font-size: 30rpx;
  color: #2c3e50;
  padding: 25rpx 35rpx;
  text-align: center;
  width: 100%;
  transition: all 0.3s ease;
  font-size: 32rpx;
  font-weight: 500;
}

.container3 navigator:active {
  color: #3498db;
}

/* Container4 样式 */
.container4 {
  z-index: 2;
  position: absolute;
  bottom: 80rpx;
  left: 40rpx;
  right: 40rpx;
  height: 100rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 0 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
}

.container4 view {
  position: relative;
  flex: 1;
  display: flex;
  justify-content: center;
}

.container4 navigator {
  font-size: 30rpx;
  color: #2c3e50;
  padding: 20rpx 40rpx;
  text-align: center;
  position: relative;
  transition: all 0.3s ease;
  font-weight: 500;
}

.container4 navigator::after {
  content: "";
  position: absolute;
  bottom: 15rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 2rpx;
  background: #3498db;
  transition: all 0.3s ease;
}

.container4 navigator:active {
  color: #3498db;
}

.container4 navigator:active::after {
  width: 60%;
}

/* 添加简洁的科技感元素 */
.container1::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(125deg, transparent 0%, rgba(52, 152, 219, 0.03) 100%);
  z-index: 1;
}

/* 电量百分比动画 */
@keyframes energyPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

#energywatch {
  animation: energyPulse 3s ease-in-out infinite;
}