<!--pages/set/set.wxml-->
<scroll-view scroll-y="" class="container1">
  <image class="bg-image" src="/images/menu_container1.jpg" mode=""/>
  <view class="container2">
    <view id="speak_control" bindtap="can_speaak">机器人语音控制<text>{{can_speak_control}}</text></view>
    <view id="element_call" bindtap="can_element">事件提醒<text>{{can_element_call}}</text></view>
    <view id="AI" bindtap="can_AI">AI陪伴<text>{{is_AI}}</text></view>
    <view id="robot_camera" bindtap="can_camera">机器人摄像头权限<text>{{open_robot_camera}}</text></view>
    <view id="content" bindtap="can_content">更多连接<text>{{can_content}}</text></view>
  </view>
</scroll-view>