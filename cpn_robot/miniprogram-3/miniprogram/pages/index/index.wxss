.container1{
  height:100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.picture{
  margin: 100rpx 0 20rpx 0;
  height: 600rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 100rpx;
  position: relative;
}

/* 轮播图容器样式 */
.content-swiper {
  position: absolute;
  width: 100%;
  height: 100%;
}

.content-image {
  width: 100%;
  height: 100%;
  opacity: 0.9;
  object-fit: cover;
}

#title {
  color: rgba(255, 255, 255, 0.8);
  position: relative;
  z-index: 2; /* 确保标题在轮播图上方 */
  font-weight: bold;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.container2{
  margin: 20rpx 100rpx;
  height:150rpx;
  width:550rpx;
  display: flex;
  flex-direction: row;
  position: relative;
  z-index: 1;
  font-size: 50rpx;
  color: rgb(202, 202, 202);
  font-weight: 300;
}

#Registion{
  margin: 30rpx 20rpx 30rpx 60rpx;
  height: 90rpx;
  width: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

#Login{
  margin: 30rpx 60rpx 30rpx 20rpx;
  height: 90rpx;
  width: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

#line{
  margin: 30rpx 0;
  height: 90rpx;
  width: 4rpx;
  background-color: rgb(202, 202, 202); 
}

#info {
  margin: 550rpx 0 20rpx 0;
  height: 70rpx;
  width: 100%;
  position: relative;
  z-index: 1;
  text-align: center;
  color: rgb(1,1,1);
  font-size: 29rpx;
}