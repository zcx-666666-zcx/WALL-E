<!--pages/login/login.wxml-->
<view class="container1">
  <view id="title">—— 登录 ——</view>
  <image class="bg-image" src="{{image_ip1}}" mode=""/>
  <view class="picture">
    <image class="pc-image" src="{{image_ip2}}" mode=""/>
    
    <view class="ipt"><input type="text" placeholder="用户名：" bindinput="login_usernameInput"/></view>
    <view class="ipt"><input type="password" placeholder="密码:" bindinput="login_passwordInput"/></view>
    <view id="login" bind:tap="Gologin">登录</view>
    
  </view>

  <view class="reg">
    <navigator url="/pages/registion/registion">没有账号？点击注册</navigator>
  </view>
</view>