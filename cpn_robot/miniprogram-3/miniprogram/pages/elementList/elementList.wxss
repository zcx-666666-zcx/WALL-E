/* pages/elementList/elementList.wxss */
.container1 {
  height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  background: #a4c5e0;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  opacity: 0.75;
}

.container1 {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  opacity: 0.9;
}

.bg-image {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.container2 {
  padding: 0rpx;
  flex: 1;
  overflow: hidden;
}

#text {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin: 20rpx 0;
  color: rgb(26, 23, 23);
  padding: 10rpx;
  border-radius: 16rpx;
  margin: 20rpx;
}

/* 事件列表样式 */
.event-list {
  margin: 0 15rpx;
}

.event-item {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 13rpx;
  padding: 30rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid rgba(13, 47, 82, 0.2);
  box-shadow: 0 4rpx 12rpx rgba(13, 47, 82, 0.1);
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.event-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #0d2f52;
  flex: 1;
}

.event-priority {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: white;
}

.priority-high {
  background: #e74c3c;
}

.priority-medium {
  background: #f39c12;
}

.priority-low {
  background: #27ae60;
}

.event-time, .event-repeat {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #2c3e50;
  margin-bottom: 5rpx;
}

.time-icon, .repeat-icon {
  margin-right: 10rpx;
  color: #0d2f52;
}

.event-description {
  font-size: 26rpx;
  color: #34495e;
  margin: 10rpx 0;
  line-height: 1.4;
  background: rgba(164, 197, 224, 0.2);
  padding: 15rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #0d2f52;
}

.event-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 15rpx;
  border-top: 1rpx solid rgba(13, 47, 82, 0.2);
  padding-top: 15rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
  cursor: pointer;
  border: none;
  font-weight: bold;
}

.edit-btn {
  background: #0d2f52;
  color: white;
}

.delete-btn {
  background: #8E8E93;
  color: white;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 100rpx 20rpx;
  color: #2c3e50;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  margin: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  color: #0d2f52;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 10rpx;
  font-weight: bold;
  color: #0d2f52;
}

.empty-desc {
  font-size: 26rpx;
  color: #7f8c8d;
}

.container3 {
  display: flex;
  padding: 20rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-top: 1rpx solid rgba(13, 47, 82, 0.2);
}

#add, #back {
  flex: 1;
  text-align: center;
}

navigator {
  display: block;
  padding: 20rpx;
  background-color: #0d2f52;
  color: white;
  border-radius: 10rpx;
  margin: 0 10rpx;
  font-weight: bold;
  text-align: center;
}

#back navigator {
  background-color: #8E8E93;
}

/* 滚动区域优化 */
scroll-view {
  height: 100%;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .event-header {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .event-priority {
    margin-top: 10rpx;
    align-self: flex-start;
  }
  
  .event-actions {
    justify-content: space-between;
  }
  
  .action-btn {
    margin-left: 0;
    flex: 1;
    text-align: center;
    margin: 0 10rpx;
  }
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #0d2f52;
  font-size: 28rpx;
}

/* 悬停效果 */
.event-item {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.event-item:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(13, 47, 82, 0.15);
}

.action-btn {
  transition: opacity 0.2s ease;
}

.action-btn:active {
  opacity: 0.8;
}