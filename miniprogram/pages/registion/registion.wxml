<!--pages/registion/registion.wxml-->
<view class="container1">
  <view id="title">—— 注册 ——</view>
  <image class="bg-image" src="{{image_ip1}}" mode=""/>
  <view class="picture">
    <image class="pc-image" src="{{image_ip2}}" mode=""/>
    
    <view class="ipt"><input type="text" placeholder="用户名：" bindinput="nameHandle"/></view>
    <view class="ipt"><input type="safe-password" password="true" placeholder="密码:" bindinput="passwordHandle"/></view>
    <view class="ipt"><input type="safe-password" password="true" placeholder="确认密码:" bindinput="sureHandle"/></view>
    <view class="ipt"><input type="text" placeholder="手机号:" bindinput="phone_numberHandle"/></view>
    <view id="regist" bind:tap="GoRegist">注册</view>
    
  </view>

  <view class="log">
    <navigator url="/pages/login/login">已有账号？点击登录</navigator>
  </view>
</view>