/* pages/CallChoice/CallChoice.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 联系人选择 */
.contact-section {
  margin-bottom: 60rpx;
}

.contact-selector {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 25rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10rpx);
}

.contact-selector.has-contact {
  background: rgba(76, 175, 80, 0.95);
}

.contact-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.contact-selector.has-contact .contact-text {
  color: white;
}

.arrow {
  font-size: 28rpx;
  color: #666;
}

.contact-selector.has-contact .arrow {
  color: white;
}

.contact-list {
  margin-top: 20rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 15rpx 40rpx rgba(0, 0, 0, 0.15);
}

.contact-item {
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item:active {
  background-color: #f8f9fa;
}

.contact-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.contact-ip {
  font-size: 26rpx;
  color: #666;
}

/* 视频通话区域 */
.video-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.local-camera, .remote-video {
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 15rpx 40rpx rgba(0, 0, 0, 0.25);
  position: relative;
  background: rgba(0, 0, 0, 0.3);
}

.video-placeholder {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.placeholder-text {
  color: white;
  font-size: 32rpx;
  font-weight: 500;
}

.video-frame {
  width: 100%;
  height: 300rpx;
}

.camera-overlay, .video-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  padding: 25rpx;
}

.status-text {
  color: white;
  font-size: 28rpx;
  font-weight: 500;
}

/* 语音通话区域 */
.audio-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 25rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  margin-bottom: 60rpx;
  box-shadow: 0 15rpx 40rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(10rpx);
}

.audio-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
}

.audio-wave {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 100rpx;
}

.wave-bar {
  width: 12rpx;
  height: 40rpx;
  background: linear-gradient(to top, #4CAF50, #8BC34A);
  border-radius: 6rpx;
  animation: wave 1s ease-in-out infinite;
}

.wave-bar:nth-child(2) { animation-delay: 0.1s; }
.wave-bar:nth-child(3) { animation-delay: 0.2s; }
.wave-bar:nth-child(4) { animation-delay: 0.3s; }
.wave-bar:nth-child(5) { animation-delay: 0.4s; }

@keyframes wave {
  0%, 100% { height: 40rpx; }
  50% { height: 80rpx; }
}

.audio-text {
  font-size: 38rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.audio-info {
  font-size: 28rpx;
  color: #666;
}

/* 控制按钮 */
.control-section {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.control-btn {
  padding: 35rpx;
  font-size: 36rpx;
  border-radius: 25rpx;
  border: none;
  color: white;
  font-weight: bold;
  box-shadow: 0 10rpx 25rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s;
}

.control-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.2);
}

.video-btn {
  background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
}

.video-btn.active {
  background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
}

.audio-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
}

.audio-btn.active {
  background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
}

.stop-btn {
  background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
}

/* 调试信息 */
.debug-section {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.debug-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.debug-item:last-child {
  margin-bottom: 0;
}

.debug-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.debug-value {
  font-size: 28rpx;
  font-weight: 500;
}

.debug-value.connected {
  color: #4CAF50;
}

.debug-value.disconnected {
  color: #f44336;
}

/* 提示区域 */
.hint-section {
  margin-top: 40rpx;
  text-align: center;
}

.hint-text {
  color: rgba(255, 255, 255, 0.85);
  font-size: 30rpx;
  font-weight: 500;
}