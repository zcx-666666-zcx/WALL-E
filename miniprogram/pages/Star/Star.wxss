/* pages/Star/Star.wxss */

.root {
  min-height: 100vh; width: 100%;
  background: #e9e3df;
  display: flex; flex-direction: column;
  box-sizing: border-box; padding-bottom: 40rpx;
  position: relative; overflow: hidden;
}
.top-bg {
  position: fixed; top: 0; left: 0; right: 0; height: 380rpx;
  background: linear-gradient(160deg, #9B7BFF 0%, #7B5BFF 60%, #5B3BE0 100%);
  z-index: 0; border-radius: 0 0 56rpx 56rpx;
}
.orb { position: fixed; border-radius: 50%; pointer-events: none; z-index: 1; }
.orb-1 {
  width: 360rpx; height: 360rpx; top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(180,160,255,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 280rpx; height: 280rpx; top: 160rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(140,100,255,0.12) 0%, transparent 70%);
}

.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  padding: 188rpx 40rpx 32rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub   { font-size: 22rpx; color: rgba(255,255,255,0.65); }

.section-label {
  position: relative; z-index: 10;
  font-size: 24rpx; font-weight: 700; color: #B09080;
  letter-spacing: 2rpx; padding: 12rpx 40rpx 16rpx; text-transform: uppercase;
}

.card-list {
  position: relative; z-index: 10;
  display: flex; flex-direction: column; gap: 14rpx; padding: 0 32rpx;
}

.empty-state {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  padding: 60rpx 40rpx; background: #FFFFFF; border-radius: 24rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
}
.empty-icon  { font-size: 56rpx; }
.empty-title { font-size: 28rpx; font-weight: 700; color: #5A3020; }
.empty-desc  { font-size: 22rpx; color: #B09080; text-align: center; }

.device-card {
  display: flex; flex-direction: row; align-items: center; gap: 18rpx;
  padding: 24rpx 24rpx; background: #FFFFFF; border-radius: 22rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
  transition: transform 0.15s ease;
}
.device-card:active { transform: scale(0.985); }

.device-icon-wrap {
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #EEE8FF, #D8D0FF);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.device-icon { font-size: 30rpx; }

.device-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.device-name { font-size: 28rpx; font-weight: 700; color: #2A1408; }
.device-id   { font-size: 20rpx; color: #B09080; font-family: monospace; }

.device-status {
  display: flex; flex-direction: row; align-items: center; gap: 8rpx;
  padding: 8rpx 18rpx; border-radius: 100rpx;
}
.conn-on  { background: rgba(76,175,132,0.1); }
.conn-off { background: rgba(180,140,120,0.08); }
.device-status-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
}
.conn-on  .device-status-dot { background: #4CAF84; }
.conn-off .device-status-dot { background: #D0B0A0; }
.device-status-text { font-size: 22rpx; font-weight: 600; }
.conn-on  .device-status-text { color: #4CAF84; }
.conn-off .device-status-text { color: #B09080; }

.action-row { position: relative; z-index: 10; padding: 0 32rpx; }
.action-btn {
  height: 88rpx;
  background: linear-gradient(90deg, #9B7BFF, #7B5BFF);
  border-radius: 22rpx;
  display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(123,91,255,0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.action-btn:active { transform: scale(0.96); opacity: 0.85; }
.action-btn-icon { font-size: 28rpx; }
.action-btn-text { font-size: 30rpx; font-weight: 700; color: white; letter-spacing: 2rpx; }
