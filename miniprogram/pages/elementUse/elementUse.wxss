/* pages/elementUse/elementUse.wxss */
.page-container {
  min-height: 100vh;
  background-color: #1e6bc7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
text{
  color: rgb(173, 173, 173);
  font-size: 25rpx;
}


.form-card {
  width: 90%;
  max-width: 700rpx;
  background-color: white;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.form-title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  color: #000;
  width: 100%;
}

.form-section {
  width: 100%;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-label {
  font-size: 36rpx;
  margin-bottom: 20rpx;
  color: #000;
  font-weight: 500;
  text-align: center;
  width: 100%;
}

.text-input {
  width: 100%;
  padding: 25rpx;
  font-size: 32rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background-color: #f9f9f9;
  color: #000;
  text-align: center;
  height: 80rpx;
  box-sizing: border-box;
  white-space: nowrap; /* 添加这一行，防止文本换行 */
  overflow: hidden; /* 添加这一行，隐藏超出部分的文本 */
  text-overflow: ellipsis; /* 可选：如果文本太长显示省略号 */
}

.text-input:focus {
  border-color: #1e6bc7;
}

.hint-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 15rpx;
  text-align: center;
  width: 100%;
}

.picker {
  width: 100%;
}

.picker-display {
  width: 100%;
  padding: 25rpx;
  font-size: 32rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background-color: #f9f9f9;
  color: #000;
  text-align: center;
  height: 80rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.priority-container {
  display: flex;
  width: 100%;
  justify-content: center;
  gap: 20rpx;
}

.priority-option {
  flex: 1;
  max-width: 180rpx;
  text-align: center;
  padding: 25rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  font-size: 32rpx;
  color: #000;
  transition: all 0.3s;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.priority-option.active {
  background-color: #1e6bc7;
  color: white;
  border-color: #1e6bc7;
  transform: scale(1.05);
}

.textarea {
  width: 100%;
  padding: 25rpx;
  font-size: 32rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  background-color: #f9f9f9;
  height: 180rpx;
  color: #000;
  text-align: center;
  box-sizing: border-box;
}

.textarea:focus {
  border-color: #1e6bc7;
}

/* 按钮容器 */
.button-container {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-top: 40rpx;
  gap: 30rpx;
}

.button {
  flex: 1;
  text-align: center;
  border-radius: 12rpx;
  font-size: 36rpx;
  font-weight: 500;
  transition: all 0.3s;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-button {
  background-color: #1e6bc7;
  color: white;
}

.back-button {
  background-color: #8E8E93;
}

.back-button navigator {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: white;
  text-decoration: none;
}

.button:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .page-container {
    padding: 20rpx;
  }
  
  .form-card {
    padding: 40rpx 30rpx;
    width: 95%;
  }
  
  .form-title {
    font-size: 42rpx;
    margin-bottom: 30rpx;
  }
  
  .section-label {
    font-size: 32rpx;
  }
  
  .text-input, .picker-display, .priority-option, .textarea {
    font-size: 30rpx;
    padding: 20rpx;
  }
  
  .text-input, .picker-display, .priority-option {
    height: 70rpx;
  }
  
  .textarea {
    height: 150rpx;
  }
  
  .button {
    font-size: 32rpx;
    height: 80rpx;
  }
  
  .priority-container {
    flex-direction: row;
    gap: 15rpx;
  }
  
  .priority-option {
    max-width: none;
  }
  
  /* 在小屏幕上确保按钮垂直排列 */
  .button-container {
    flex-direction: column;
    gap: 20rpx;
  }
}

/* 针对超小屏幕的额外调整 */
@media (max-width: 400rpx) {
  .form-card {
    padding: 30rpx 20rpx;
  }
  
  .form-title {
    font-size: 38rpx;
  }
  
  .section-label {
    font-size: 28rpx;
  }
  
  .text-input, .picker-display, .priority-option, .textarea {
    font-size: 26rpx;
    padding: 15rpx;
  }
  
  .button {
    font-size: 28rpx;
  }
  
  .priority-container {
    flex-direction: column;
  }
}