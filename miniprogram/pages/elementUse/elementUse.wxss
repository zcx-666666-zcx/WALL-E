/* pages/elementUse/elementUse.wxss */

.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 340rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 260rpx; height: 260rpx;
  top: 140rpx; left: -50rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 188rpx 40rpx 28rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub   { font-size: 22rpx; color: rgba(255,255,255,0.65); }

/* Form card */
.form-card {
  position: relative; z-index: 10;
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 20rpx rgba(200,90,50,0.07);
  padding: 32rpx 28rpx;
}

.form-section { margin-bottom: 32rpx; }

.form-label {
  font-size: 28rpx; font-weight: 600;
  color: #3A2010; margin-bottom: 14rpx;
}

.form-input {
  width: 100%; height: 88rpx;
  background: #FFF8F5;
  border: 1rpx solid rgba(255,160,120,0.25);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx; color: #3A2010;
  box-sizing: border-box;
}
.form-ph { color: rgba(180,140,120,0.5); font-size: 28rpx; }

.form-picker { width: 100%; }
.form-picker-display {
  width: 100%; height: 88rpx;
  background: #FFF8F5;
  border: 1rpx solid rgba(255,160,120,0.25);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx; color: #3A2010;
  box-sizing: border-box;
  display: flex; align-items: center;
}

.form-textarea {
  width: 100%; min-height: 150rpx;
  background: #FFF8F5;
  border: 1rpx solid rgba(255,160,120,0.25);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx; color: #3A2010;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-hint {
  font-size: 22rpx; color: #C4A898;
  margin-top: 8rpx; display: block;
}

/* Priority row */
.priority-row {
  display: flex; gap: 16rpx;
  margin-bottom: 6rpx;
}
.pri-opt {
  flex: 1; height: 76rpx;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600;
  background: #FFF5F0;
  color: #B09080;
  border: 2rpx solid rgba(255,160,120,0.1);
  transition: all 0.2s ease;
}
.pri-active { border: 2rpx solid transparent; color: #FFFFFF; }
.pri-active.pri-low  { background: linear-gradient(135deg, #89C997, #4CAF84); }
.pri-active.pri-mid  { background: linear-gradient(135deg, #FFC050, #FFB020); }
.pri-active.pri-high { background: linear-gradient(135deg, #FF7A50, #FF5A36); }

/* Buttons */
.form-actions {
  display: flex; gap: 20rpx;
  margin-top: 40rpx;
}
.btn-save {
  flex: 1.3; height: 88rpx;
  background: linear-gradient(90deg, #FF9A76, #FF5A30);
  border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255,96,64,0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-save:active { transform: scale(0.96); opacity: 0.85; }
.btn-save-text { font-size: 30rpx; font-weight: 700; color: white; letter-spacing: 2rpx; }

.btn-back {
  flex: 1; height: 88rpx;
  background: #FFF0E8;
  border: 1rpx solid rgba(220,120,80,0.2);
  border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
  text-align: center;
}
.btn-back:active { background: #FFE4D4; }
.btn-back-text { font-size: 28rpx; font-weight: 600; color: #C06030; }
