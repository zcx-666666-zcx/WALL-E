/* pages/commandList/commandList.wxss */

.root {
  min-height: 100vh; width: 100%;
  background: #e9e3df;
  display: flex; flex-direction: column;
  box-sizing: border-box; padding-bottom: 40rpx;
  position: relative; overflow: hidden;
}
.top-bg {
  position: fixed; top: 0; left: 0; right: 0; height: 340rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0; border-radius: 0 0 56rpx 56rpx;
}
.orb { position: fixed; border-radius: 50%; pointer-events: none; z-index: 1; }
.orb-1 {
  width: 360rpx; height: 360rpx; top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 260rpx; height: 260rpx; top: 140rpx; left: -50rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  padding: 188rpx 40rpx 28rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub   { font-size: 22rpx; color: rgba(255,255,255,0.65); }

.card-list {
  position: relative; z-index: 10;
  display: flex; flex-direction: column; gap: 14rpx; padding: 20rpx 32rpx 0;
}

.empty-state {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  padding: 60rpx 40rpx; background: #FFFFFF; border-radius: 24rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
}
.empty-icon  { font-size: 56rpx; }
.empty-title { font-size: 28rpx; font-weight: 700; color: #5A3020; }
.empty-desc  { font-size: 22rpx; color: #B09080; text-align: center; }

.cmd-card {
  background: #FFFFFF; border-radius: 22rpx;
  padding: 24rpx 24rpx 20rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
  display: flex; flex-direction: column; gap: 14rpx;
}

.cmd-header {
  display: flex; flex-direction: row; align-items: center; gap: 10rpx;
}
.cmd-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%; background: #FF9A76;
}
.cmd-time { font-size: 21rpx; color: #B09080; flex: 1; }
.cmd-status {
  border-radius: 100rpx; padding: 4rpx 16rpx;
}
.status-ok   { background: rgba(76,175,132,0.12); }
.status-fail { background: rgba(255,90,54,0.1); }
.status-ok   .cmd-status-text { font-size: 20rpx; font-weight: 600; color: #4CAF84; }
.status-fail .cmd-status-text { font-size: 20rpx; font-weight: 600; color: #FF5A36; }

.cmd-content { font-size: 26rpx; color: #3A2010; line-height: 1.6; }
.cmd-reply {
  font-size: 24rpx; color: #B09080; line-height: 1.6;
  background: #FFF8F5; padding: 12rpx 16rpx;
  border-radius: 12rpx; border-left: 3rpx solid #FF9A76;
}
