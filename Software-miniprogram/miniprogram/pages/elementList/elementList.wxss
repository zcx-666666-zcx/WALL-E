/* pages/elementList/elementList.wxss */

/* ══ 根容器 ══ */
.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ══ 顶部背景 ══ */
.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 340rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 260rpx; height: 260rpx;
  top: 160rpx; left: -50rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

/* ══ 顶部标题 ══ */
.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 188rpx 40rpx 28rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub   { font-size: 22rpx; color: rgba(255,255,255,0.65); }

/* 顶部添加按钮 */
.add-btn {
  display: flex; flex-direction: row; align-items: center; gap: 6rpx;
  background: rgba(255,255,255,0.2);
  border: 1rpx solid rgba(255,255,255,0.35);
  border-radius: 100rpx; padding: 12rpx 24rpx;
}
.add-btn-hover { background: rgba(255,255,255,0.3); }
.add-btn-icon { font-size: 30rpx; color: white; font-weight: 700; line-height: 1; }
.add-btn-text { font-size: 24rpx; color: rgba(255,255,255,0.95); font-weight: 600; }

/* ══ 列表滚动区 ══ */
.list-wrap {
  position: relative; z-index: 10;
  flex: 1;
  padding: 8rpx 32rpx 0;
  height: calc(100vh - 240rpx);
  box-sizing: border-box;
}

/* ══ 空状态 ══ */
.empty-state {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 12rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
}
.empty-icon  { font-size: 64rpx; }
.empty-title { font-size: 30rpx; font-weight: 700; color: #5A3020; }
.empty-desc  { font-size: 24rpx; color: #B09080; text-align: center; line-height: 1.6; }

/* ══ 事件卡片 ══ */
.event-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
}
.event-card:active { opacity: 0.92; }

/* 卡片顶部 */
.card-header {
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.card-name-row {
  display: flex; flex-direction: row; align-items: center; gap: 12rpx; flex: 1;
}
.card-pri-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%; flex-shrink: 0;
}
.pri-high { background: #FF5A36; }
.pri-mid  { background: #FFB020; }
.pri-low  { background: #4CAF84; }

.card-name {
  font-size: 30rpx; font-weight: 700; color: #2A1408;
  flex: 1; overflow: hidden;
}

/* 优先级胶囊 */
.pri-badge {
  border-radius: 100rpx; padding: 5rpx 16rpx; flex-shrink: 0;
}
.pri-badge-high { background: rgba(255,90,54,0.1); }
.pri-badge-mid  { background: rgba(255,176,32,0.12); }
.pri-badge-low  { background: rgba(76,175,132,0.1); }
.pri-badge-text { font-size: 20rpx; font-weight: 600; }
.pri-badge-high .pri-badge-text { color: #C03020; }
.pri-badge-mid  .pri-badge-text { color: #A07010; }
.pri-badge-low  .pri-badge-text { color: #2A7050; }

/* 时间 + 重复 */
.card-meta {
  display: flex; flex-direction: column; gap: 8rpx;
  margin-bottom: 14rpx;
}
.meta-item {
  display: flex; flex-direction: row; align-items: center; gap: 10rpx;
}
.meta-icon { font-size: 24rpx; }
.meta-text { font-size: 24rpx; color: #7A5040; }

/* 描述 */
.card-desc {
  background: #FFF8F5;
  border-left: 4rpx solid #FF9A76;
  border-radius: 0 10rpx 10rpx 0;
  padding: 14rpx 16rpx;
  margin-bottom: 16rpx;
}
.card-desc-text { font-size: 24rpx; color: #6A4030; line-height: 1.65; }

/* 操作按钮 */
.card-actions {
  display: flex; flex-direction: row; gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255,160,120,0.1);
  justify-content: flex-end;
}
.act-btn {
  display: flex; flex-direction: row; align-items: center; gap: 6rpx;
  height: 60rpx; padding: 0 22rpx;
  border-radius: 12rpx;
}
.act-btn:active { opacity: 0.78; }
.act-edit { background: #FFF0E8; }
.act-del  { background: #FFF0F0; }
.act-icon { font-size: 22rpx; }
.act-edit .act-text { font-size: 24rpx; font-weight: 600; color: #C06030; }
.act-del  .act-text { font-size: 24rpx; font-weight: 600; color: #C03030; }

/* ══ 底部操作栏 ══ */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  z-index: 100;
  display: flex; flex-direction: row; gap: 16rpx;
  padding: 16rpx 32rpx 40rpx;
  background: rgba(251,245,240,0.96);
  border-top: 1rpx solid rgba(255,160,120,0.15);
  box-shadow: 0 -4rpx 20rpx rgba(200,90,50,0.07);
  box-sizing: border-box;
}
.bottom-btn {
  flex: 1; height: 88rpx;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  border-radius: 20rpx; text-align: center;
}
.btn-add {
  background: linear-gradient(90deg, #FF9A76, #FF6040);
  box-shadow: 0 6rpx 20rpx rgba(255,96,64,0.3);
}
.btn-add .bottom-btn-icon { font-size: 28rpx; color: white; font-weight: 700; }
.btn-add .bottom-btn-text { font-size: 28rpx; font-weight: 700; color: white; }
.bottom-btn-hover { opacity: 0.85; }

.btn-back {
  background: #FFF0E8;
  border: 1rpx solid rgba(220,120,80,0.2);
}
.btn-back .bottom-btn-text { font-size: 28rpx; font-weight: 600; color: #C06030; }
.bottom-btn-back-hover { background: #FFE4D4; }
