<view class="root">

<health-bar></health-bar>
<alert-modal></alert-modal>

<!-- 顶部暖色背景 -->
<view class="top-bg"></view>
<view class="orb orb-1"></view>
<view class="orb orb-2"></view>

<!-- 顶部标题区 -->
<view class="header">
  <view class="header-left">
    <text class="header-title">事件提醒</text>
    <text class="header-sub">共 {{elements.length}} 条事件</text>
  </view>
  <navigator class="add-btn" url="/pages/elementUse/elementUse" hover-class="add-btn-hover">
    <text class="add-btn-icon">＋</text>
    <text class="add-btn-text">添加</text>
  </navigator>
</view>

<!-- 事件列表 -->
<scroll-view class="list-wrap" scroll-y="{{true}}">

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{elements.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无事件</text>
    <text class="empty-desc">点击右上角「添加」创建第一条提醒</text>
  </view>

  <!-- 事件卡片 -->
  <view
    class="event-card"
    wx:for="{{elements}}"
    wx:key="id"
  >
    <!-- 卡片顶部：名称 + 优先级 -->
    <view class="card-header">
      <view class="card-name-row">
        <view class="card-pri-dot pri-{{item.priority === 'HIGH' ? 'high' : item.priority === 'MEDIUM' ? 'mid' : 'low'}}"></view>
        <text class="card-name">{{item.eventName}}</text>
      </view>
      <view class="pri-badge pri-badge-{{item.priority === 'HIGH' ? 'high' : item.priority === 'MEDIUM' ? 'mid' : 'low'}}">
        <text class="pri-badge-text">{{item.priority === 'HIGH' ? '高优先级' : item.priority === 'MEDIUM' ? '中优先级' : '低优先级'}}</text>
      </view>
    </view>

    <!-- 时间 + 重复 -->
    <view class="card-meta">
      <view class="meta-item">
        <text class="meta-icon">📅</text>
        <text class="meta-text">{{item.eventDate}} {{item.eventTime}}</text>
      </view>
      <view class="meta-item" wx:if="{{item.repeatDays}}">
        <text class="meta-icon">🔄</text>
        <text class="meta-text">每 {{item.repeatDays}} 天重复</text>
      </view>
    </view>

    <!-- 事件描述 -->
    <view class="card-desc" wx:if="{{item.description}}">
      <text class="card-desc-text">{{item.description}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="card-actions">
      <view class="act-btn act-edit" bindtap="onEditTap" data-id="{{item.id}}">
        <text class="act-icon">✏️</text>
        <text class="act-text">编辑</text>
      </view>
      <view class="act-btn act-del" bindtap="onDeleteTap" data-id="{{item.id}}">
        <text class="act-icon">🗑️</text>
        <text class="act-text">删除</text>
      </view>
    </view>
  </view>

  <view style="height: 160rpx;"></view>
</scroll-view>

<!-- 底部操作栏 -->
<view class="bottom-bar">
  <navigator class="bottom-btn btn-add" url="/pages/elementUse/elementUse" hover-class="bottom-btn-hover">
    <text class="bottom-btn-icon">＋</text>
    <text class="bottom-btn-text">添加事件</text>
  </navigator>
  <navigator class="bottom-btn btn-back" url="/pages/menu/menu" hover-class="bottom-btn-back-hover">
    <text class="bottom-btn-text">返回主页</text>
  </navigator>
</view>

</view>
