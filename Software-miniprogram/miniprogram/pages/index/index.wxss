/* index.wxss */

/* ══ 根容器 ══ */
.root {
  min-height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  background-color: #0A0F1E;
}

/* ══ 背景图 ══ */
.bg-image {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
  opacity: 0.55;
}

/* 深色渐变遮罩：底部更深，突出按钮区域 */
.bg-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(5, 10, 30, 0.45) 0%,
    rgba(5, 10, 30, 0.3) 35%,
    rgba(5, 10, 30, 0.55) 70%,
    rgba(5, 10, 30, 0.82) 100%
  );
}

/* 装饰光晕 */
.orb {
  position: fixed;
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
}
.orb-1 {
  width: 500rpx; height: 500rpx;
  top: -150rpx; right: -100rpx;
  background: radial-gradient(circle, rgba(255,120,60,0.12) 0%, transparent 70%);
}
.orb-2 {
  width: 400rpx; height: 400rpx;
  bottom: 200rpx; left: -100rpx;
  background: radial-gradient(circle, rgba(60,100,255,0.1) 0%, transparent 70%);
}

/* ══ 品牌区 ══ */
.brand-area {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-top: 100rpx;
  padding: 0 50rpx;
  width: 100%;
  box-sizing: border-box;
}
.brand-logo {
  width: 72rpx; height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,154,118,0.9), rgba(255,90,48,0.9));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,90,48,0.35);
  flex-shrink: 0;
}
.logo-heart {
  font-size: 34rpx;
  color: white;
}
.brand-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.brand-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}
.brand-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 1rpx;
}

/* ══ 轮播图 ══ */
.swiper-wrap {
  position: relative;
  z-index: 10;
  width: 650rpx;
  height: 420rpx;
  margin-top: 48rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.4);
  border: 1rpx solid rgba(255,255,255,0.1);
}
.swiper {
  width: 100%;
  height: 100%;
}
.swiper-img {
  width: 100%;
  height: 100%;
}
.swiper-mask {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 160rpx;
  background: linear-gradient(transparent, rgba(5,10,30,0.7));
}
.swiper-caption {
  position: absolute;
  bottom: 28rpx;
  left: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.9);
  letter-spacing: 1rpx;
  z-index: 2;
}

/* ══ 标语 ══ */
.slogan-area {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 52rpx;
  padding: 0 60rpx;
  text-align: center;
}
.slogan-main {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}
.slogan-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 1rpx;
}

/* ══ 按钮区 ══ */
.action-area {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-top: 60rpx;
  width: 100%;
  padding: 0 80rpx;
  box-sizing: border-box;
}

/* 主按钮 */
.btn-primary {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(90deg, #FF9A76, #FF5A30);
  border-radius: 48rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 32rpx rgba(255,90,48,0.4);
}
.btn-primary-hover {
  opacity: 0.85;
  transform: scale(0.98);
}
.btn-primary-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}
.btn-arrow {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
}

/* 幽灵按钮 */
.btn-ghost {
  width: 100%;
  height: 90rpx;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.22);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-ghost-hover {
  background: rgba(255,255,255,0.14);
}
.btn-ghost-text {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  letter-spacing: 4rpx;
}

/* ══ 特性标签行 ══ */
.tags-row {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-top: 52rpx;
}
.tag-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}
.tag-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #FF9A76;
  box-shadow: 0 0 8rpx rgba(255,154,118,0.6);
  flex-shrink: 0;
}
.tag-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  letter-spacing: 1rpx;
}
.tag-sep {
  width: 1rpx;
  height: 24rpx;
  background: rgba(255,255,255,0.2);
}

/* ══ 底部版权 ══ */
.footer {
  position: relative;
  z-index: 10;
  margin-top: 48rpx;
  margin-bottom: 40rpx;
}
.footer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  letter-spacing: 1rpx;
}
