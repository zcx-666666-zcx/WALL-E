/* pages/login/login.wxss */

.root {
  min-height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  background-color: #0A0F1E;
}

/* 背景 */
.bg-image {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
  opacity: 0.5;
}
.bg-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(5,10,30,0.5) 0%,
    rgba(5,10,30,0.35) 30%,
    rgba(5,10,30,0.65) 70%,
    rgba(5,10,30,0.88) 100%
  );
}
.orb {
  position: fixed;
  border-radius: 50%;
  z-index: 1;
  pointer-events: none;
}
.orb-1 {
  width: 480rpx; height: 480rpx;
  top: -120rpx; right: -80rpx;
  background: radial-gradient(circle, rgba(255,120,60,0.13) 0%, transparent 70%);
}
.orb-2 {
  width: 360rpx; height: 360rpx;
  bottom: 160rpx; left: -80rpx;
  background: radial-gradient(circle, rgba(60,100,255,0.1) 0%, transparent 70%);
}

/* 品牌区 */
.brand-area {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-top: 100rpx;
  padding: 0 50rpx;
  width: 100%;
  box-sizing: border-box;
}
.brand-logo {
  width: 72rpx; height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255,154,118,0.9), rgba(255,90,48,0.9));
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,90,48,0.35);
  flex-shrink: 0;
}
.logo-heart { font-size: 34rpx; color: white; }
.brand-text { display: flex; flex-direction: column; gap: 4rpx; }
.brand-name { font-size: 38rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.brand-sub { font-size: 22rpx; color: rgba(255,255,255,0.5); letter-spacing: 1rpx; }

/* 登录卡片 */
.card {
  position: relative;
  z-index: 10;
  width: 650rpx;
  margin-top: 56rpx;
  background: rgba(255,255,255,0.07);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 36rpx;
  padding: 52rpx 48rpx 44rpx;
  box-sizing: border-box;
  backdrop-filter: blur(20px);
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,0.4);
}

.card-header {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 52rpx;
}
.card-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}
.card-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.45);
  letter-spacing: 1rpx;
}

/* 输入字段 */
.field-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 32rpx;
}
.field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.6);
  letter-spacing: 1rpx;
}
.field-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.14);
  border-radius: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  gap: 16rpx;
}
.field-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  opacity: 0.6;
}
.field-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #FFFFFF;
  background: transparent;
}
.field-ph {
  color: rgba(255,255,255,0.28);
  font-size: 26rpx;
}

/* 登录按钮 */
.btn-primary {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(90deg, #FF9A76, #FF5A30);
  border-radius: 48rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 32rpx rgba(255,90,48,0.4);
  margin-top: 12rpx;
}
.btn-primary:active { opacity: 0.85; }
.btn-primary-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}
.btn-arrow {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
}

/* 分割线 */
.divider {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin: 36rpx 0 28rpx;
}
.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255,255,255,0.12);
}
.divider-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  white-space: nowrap;
}

/* 幽灵按钮 */
.btn-ghost {
  width: 100%;
  height: 88rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.18);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-ghost-hover { background: rgba(255,255,255,0.12); }
.btn-ghost-text {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.75);
  letter-spacing: 3rpx;
}

/* 特性标签行 */
.tags-row {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-top: 52rpx;
}
.tag-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}
.tag-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #FF9A76;
  box-shadow: 0 0 8rpx rgba(255,154,118,0.6);
  flex-shrink: 0;
}
.tag-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 1rpx;
}
.tag-sep {
  width: 1rpx; height: 24rpx;
  background: rgba(255,255,255,0.2);
}

/* 底部 */
.footer {
  position: relative;
  z-index: 10;
  margin-top: 48rpx;
  margin-bottom: 48rpx;
}
.footer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.28);
  letter-spacing: 1rpx;
}
