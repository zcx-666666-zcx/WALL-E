/* pages/user/user.wxss */

.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 420rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 280rpx; height: 280rpx;
  top: 180rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

/* Header */
.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 188rpx 40rpx 32rpx;
}
.header-left { display: flex; flex-direction: row; align-items: center; gap: 20rpx; }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: rgba(255,255,255,0.25);
  border: 3rpx solid rgba(255,255,255,0.5);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}
.avatar-text { font-size: 42rpx; font-weight: 800; color: white; }
.header-info { display: flex; flex-direction: column; gap: 6rpx; }
.header-name { font-size: 38rpx; font-weight: 700; color: #FFFFFF; letter-spacing: 1rpx; }
.header-sub  { font-size: 22rpx; color: rgba(255,255,255,0.65); }

/* Section label */
.section-label {
  position: relative; z-index: 10;
  font-size: 24rpx; font-weight: 700; color: #B09080;
  letter-spacing: 2rpx; padding: 12rpx 40rpx 16rpx;
  text-transform: uppercase;
}

/* Menu cards */
.menu-cards {
  position: relative; z-index: 10;
  display: flex; flex-direction: column;
  gap: 14rpx; padding: 0 32rpx;
}

.menu-card {
  display: flex; flex-direction: row; align-items: center;
  gap: 20rpx; padding: 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}
.card-hover, .menu-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(200,90,50,0.08);
}

.menu-card-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.icon-contact  { background: linear-gradient(135deg, #E8F5FF, #D0E8FF); }
.icon-settings { background: linear-gradient(135deg, #FFF0E8, #FFDECA); }
.icon-events   { background: linear-gradient(135deg, #EDF8F0, #D0F0DC); }
.icon-commands { background: linear-gradient(135deg, #FFF5E8, #FFECD0); }
.icon-star     { background: linear-gradient(135deg, #F8F0FF, #E8D8FF); }

.menu-card-icon { font-size: 34rpx; }

.menu-card-body { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.menu-card-title { font-size: 28rpx; font-weight: 700; color: #2A1408; }
.menu-card-sub   { font-size: 21rpx; color: #B09080; }
.menu-card-arrow { font-size: 26rpx; color: rgba(200,140,100,0.4); }

/* Exit */
.exit-area {
  position: relative; z-index: 10;
  margin-top: 40rpx; padding: 0 32rpx;
}
.exit-btn {
  width: 100%; height: 88rpx;
  background: #FFF0F0;
  border: 1rpx solid rgba(220, 80, 80, 0.2);
  border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
}
.exit-btn:active { background: #FFE0E0; }
.exit-btn-text { font-size: 30rpx; font-weight: 600; color: #D63031; }
