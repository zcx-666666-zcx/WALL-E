<view class="root">

<!-- 背景图 -->
<image class="bg-image" src="http://localhost:8080/images/index_container1.png" mode="scaleToFill"></image>
<!-- 渐变遮罩 -->
<view class="bg-overlay"></view>
<!-- 装饰光晕 -->
<view class="orb orb-1"></view>
<view class="orb orb-2"></view>

<!-- 顶部品牌区 -->
<view class="brand-area">
  <view class="brand-logo">
    <text class="logo-heart">♡</text>
  </view>
  <view class="brand-text">
    <text class="brand-name">智能陪伴</text>
    <text class="brand-sub">机器人管理平台</text>
  </view>
</view>

<!-- 轮播图 -->
<view class="swiper-wrap">
  <swiper
    class="swiper"
    indicator-dots="{{true}}"
    indicator-color="rgba(255,255,255,0.3)"
    indicator-active-color="#FF9A76"
    autoplay="{{true}}"
    interval="{{3500}}"
    duration="{{500}}"
    circular="{{true}}"
  >
    <swiper-item>
      <image class="swiper-img" src="http://localhost:8080/images/index_picture.png" mode="aspectFill"></image>
      <view class="swiper-mask"></view>
      <text class="swiper-caption">守护健康，随时在线</text>
    </swiper-item>
    <swiper-item>
      <image class="swiper-img" src="http://localhost:8080/images/index_picture2.png" mode="aspectFill"></image>
      <view class="swiper-mask"></view>
      <text class="swiper-caption">智能陪伴，温暖相守</text>
    </swiper-item>
    <swiper-item>
      <image class="swiper-img" src="http://localhost:8080/images/index_picture3.png" mode="aspectFill"></image>
      <view class="swiper-mask"></view>
      <text class="swiper-caption">远程监护，安心无忧</text>
    </swiper-item>
  </swiper>
</view>

<!-- 标语 -->
<view class="slogan-area">
  <text class="slogan-main">让关爱触手可及</text>
  <text class="slogan-sub">为每一位长辈提供贴心守护</text>
</view>

<!-- 按钮区 -->
<view class="action-area">
  <navigator class="btn-primary" url="/pages/login/login" hover-class="btn-primary-hover">
    <text class="btn-primary-text">立即登录</text>
    <text class="btn-arrow">→</text>
  </navigator>
  <navigator class="btn-ghost" url="/pages/registion/registion" hover-class="btn-ghost-hover">
    <text class="btn-ghost-text">注册账号</text>
  </navigator>
</view>

<!-- 特性标签 -->
<view class="tags-row">
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">健康监护</text>
  </view>
  <view class="tag-sep"></view>
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">情感陪伴</text>
  </view>
  <view class="tag-sep"></view>
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">生活助手</text>
  </view>
</view>

<!-- 底部版权 -->
<view class="footer">
  <text class="footer-text">郑州轻工业大学 · 智伴银铃团队</text>
</view>

</view>
