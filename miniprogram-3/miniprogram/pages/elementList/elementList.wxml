<!--pages/elementList/elementList.wxml-->
<view class="container1">
  <image class="bg-image" src="{{image_ip}}" mode=""/>

  <scroll-view scroll-y="true" class="container2">
    <view id="text">已添加事件</view>
    
    <!-- 事件列表 -->
    <view class="event-list">
      <view class="event-item" wx:for="{{elements}}" wx:key="id" data-event="{{item}}" bindtap="onEventTap">
        <view class="event-header">
          <view class="event-name">{{item.eventName}}</view>
          <view class="event-priority priority-{{item.priority.toLowerCase()}}">
            {{item.priority === 'HIGH' ? '高' : item.priority === 'MEDIUM' ? '中' : '低'}}
          </view>
        </view>
        
        <view class="event-time">
          <text class="time-icon">📅</text>
          {{item.eventDate}} {{item.eventTime}}
        </view>
        
        <view class="event-repeat" wx:if="{{item.repeatDays}}">
          <text class="repeat-icon">🔄</text>
          每{{item.repeatDays}}天重复
        </view>
        
        <view class="event-description" wx:if="{{item.description}}">
          {{item.description}}
        </view>
        
        <view class="event-actions">
          <view class="action-btn edit-btn" bindtap="onEditTap" data-id="{{item.id}}">编辑</view>
          <view class="action-btn delete-btn" bindtap="onDeleteTap" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{elements.length === 0}}">
      <view class="empty-icon">📝</view>
      <view class="empty-text">暂无事件</view>
      <view class="empty-desc">点击下方按钮添加第一个事件</view>
    </view>
  </scroll-view>

  <view class="container3">
    <view id="add"><navigator url="/pages/elementUse/elementUse">添加事件</navigator></view>
    <view id="back"><navigator url="/pages/menu/menu">返回</navigator></view>
  </view>
</view>