<!--pages/user/user.wxml-->
<scroll-view class="container1" scroll-y="">
  <image class="bg-image" src="{{image_ip}}" alt=""/>
  <view id="user"><text style="{{username_style}}">{{username}}</text></view>
  <view class="container2">
    <view id="add_call_for">联系人</view>
    <view id="set"><navigator url="/pages/set/set">功能设置</navigator></view>
    <view id="events">事件提醒记录</view>
    <view id="command">产品端指令记录</view>
    <view id="Star">星闪智能连接设备管理</view>
    <view id="exit" bind:tap="exit">退出登录</view>
  </view>
</scroll-view>