/* pages/user/user.wxss */
.container1 {
  height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  background: #746e63;
}
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  opacity: 0.75;
}
.container2{
  padding: 1.5% 0;
  margin: 0% 2.5% 15% 2.5%;
  height: 88.5%;
  width: 95%;
  position: relative;
  z-index: 2;
  background-color: rgba(255, 255, 255,0.55);
  border-radius: 30rpx;
}
#user{
  margin: 2% 0;
  padding: 0 2%;
  height: 6%;
  width: 100%;
  position: relative;
  z-index: 2;
  background-color: rgba(255, 255, 255, 0.3);
  text-align: center;
  display: flex;
  justify-content: left;
  align-items: center;
  color: rgb(102, 102, 102);
  font-size: 34rpx;
  font-weight: 600;
}
#add_call_for,
#set,
#events,
#command,
#Star,
#exit {
  margin: 2% 5%;
  padding: 0 4%;
  height: 6%;
  position: relative;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
  display: flex;
  justify-content: left;
  align-items: center;
  color: #333333;
  font-size: 30rpx;
  transition: all 0.3s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

#add_call_for:active,
#set:active,
#events:active,
#command:active,
#Star:active,
#exit:active {
  background-color: rgba(255, 255, 255, 0.9);
  transform: scale(0.98);
}
#exit {
  margin-top: 10%;
  background-color: rgba(255, 235, 235, 0.7);
  color: #d63031;
  font-weight: 600;
  border: 2rpx solid rgba(255, 200, 200, 0.8);
}

#exit:active {
  background-color: rgba(255, 220, 220, 0.9);
}
