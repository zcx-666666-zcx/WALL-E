/* pages/drive/drive.wxss */

/* ══ 根容器 ══ */
.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

/* ══ 顶部背景 ══ */
.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 340rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 260rpx; height: 260rpx;
  top: 160rpx; left: -50rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

/* ══ 顶部标题 ══ */
.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 88rpx 40rpx 28rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub   { font-size: 22rpx; color: rgba(255,255,255,0.65); }

/* 连接状态胶囊 */
.conn-chip {
  display: flex; flex-direction: row; align-items: center; gap: 8rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 100rpx; padding: 10rpx 22rpx;
}
.conn-chip-off { background: rgba(255,255,255,0.1); }
.conn-chip-on  { background: rgba(100,220,150,0.2); border-color: rgba(100,220,150,0.4); }
.conn-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
}
.conn-chip-off .conn-dot { background: rgba(255,255,255,0.5); }
.conn-chip-on  .conn-dot { background: #A8FFCA; }
.conn-text { font-size: 22rpx; color: rgba(255,255,255,0.9); }

/* ══ 视频区域 ══ */
.video-card {
  position: relative; z-index: 10;
  margin: 0 32rpx;
  background: #1A100A;
  border-radius: 22rpx; overflow: hidden;
  height: 280rpx;
  border: 1rpx solid rgba(255,160,120,0.15);
  box-shadow: 0 8rpx 28rpx rgba(20,8,2,0.25);
}
.video-screen {
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 10rpx;
}
.video-placeholder-icon { font-size: 48rpx; opacity: 0.35; }
.video-placeholder-text { font-size: 24rpx; color: rgba(255,160,100,0.4); }

.video-label-row {
  position: absolute; bottom: 16rpx; left: 18rpx;
  display: flex; flex-direction: row; align-items: center; gap: 8rpx;
  background: rgba(0,0,0,0.35); border-radius: 100rpx; padding: 6rpx 16rpx;
}
.video-rec-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: rgba(255,200,150,0.4);
}
.video-label-text { font-size: 20rpx; color: rgba(255,255,255,0.7); }

/* ══ 分区标签 ══ */
.section-label {
  position: relative; z-index: 10;
  font-size: 24rpx; font-weight: 700; color: #B09080;
  letter-spacing: 2rpx; padding: 24rpx 40rpx 12rpx;
  text-transform: uppercase;
}

/* ══ 遥控区整体 ══ */
.control-wrap {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: center;
  gap: 32rpx;
  padding: 0 32rpx;
}

/* ══ 云台竖排 ══ */
.gimbal-col {
  display: flex; flex-direction: column;
  align-items: center; gap: 14rpx;
}
.gimbal-label {
  font-size: 20rpx; font-weight: 600;
  color: #B09080; letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}
.btn-gimbal {
  width: 120rpx; height: 120rpx;
  background: linear-gradient(135deg, #FFF5E8, #FFE8CC);
  border: 2rpx solid rgba(220,150,80,0.3);
  border-radius: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(200,120,40,0.12), inset 0 1rpx 0 rgba(255,255,255,0.8);
}

/* ══ 十字方向键 ══ */
.dpad {
  display: flex; flex-direction: column;
  align-items: center; gap: 12rpx;
}
.dpad-row {
  display: flex; flex-direction: row;
  align-items: center; justify-content: center; gap: 12rpx;
}
.btn-dir {
  width: 140rpx; height: 140rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFFFFF, #FFF5F0);
  border: 2rpx solid rgba(255,160,120,0.25);
  box-shadow: 0 6rpx 18rpx rgba(200,90,50,0.1), inset 0 1rpx 0 rgba(255,255,255,0.9);
}
/* 前进/后退稍大 */
.btn-forward, .btn-back {
  width: 140rpx; height: 130rpx;
}

/* 中心装饰圆 */
.dpad-center {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #FBF5F0;
  border: 2rpx solid rgba(255,160,120,0.15);
  display: flex; align-items: center; justify-content: center;
}
.dpad-center-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: rgba(255,160,120,0.3);
}

/* ══ 通用按钮样式 ══ */
.ctrl-btn {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 6rpx;
  transition: all 0.1s ease;
}
.ctrl-btn:active, .btn-active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(200,90,50,0.15), inset 0 2rpx 4rpx rgba(0,0,0,0.05) !important;
}
.btn-dir.btn-active {
  background: linear-gradient(135deg, #FF9A76, #FF6040) !important;
  border-color: transparent !important;
}
.btn-gimbal.btn-active {
  background: linear-gradient(135deg, #FFB060, #FF8A30) !important;
  border-color: transparent !important;
}

/* 箭头和标签 */
.dpad-arrow {
  font-size: 36rpx; line-height: 1;
  color: #C06030; font-weight: 700;
}
.dpad-label {
  font-size: 18rpx; font-weight: 600; color: #B09080;
}
.btn-active .dpad-arrow { color: white; }
.btn-active .dpad-label { color: rgba(255,255,255,0.8); }

.btn-arrow {
  font-size: 32rpx; line-height: 1;
  color: #C07030; font-weight: 700;
}
.btn-label {
  font-size: 18rpx; font-weight: 600; color: #B09080;
}
.btn-gimbal.btn-active .btn-arrow { color: white; }
.btn-gimbal.btn-active .btn-label { color: rgba(255,255,255,0.8); }

/* ══ 提示文字 ══ */
.hint-row {
  position: relative; z-index: 10;
  display: flex; align-items: center; justify-content: center;
  margin-top: 24rpx;
}
.hint-text {
  font-size: 22rpx; color: #C4A898;
  letter-spacing: 0.5rpx;
}
