/* pages/menu/menu.wxss */

/* ══ 根容器 ══ */
.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 130rpx; /* 给底部导航留空间 */
  position: relative;
  overflow: hidden;
}

/* ══ 背景装饰 ══ */
.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 480rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 60rpx 60rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 400rpx; height: 400rpx;
  top: -120rpx; right: -80rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.25) 0%, transparent 70%);
}
.orb-2 {
  width: 300rpx; height: 300rpx;
  top: 200rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.15) 0%, transparent 70%);
}

/* ══ 顶部问候区 ══ */
.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 88rpx 40rpx 36rpx;
}
.header-left {
  display: flex; flex-direction: row; align-items: center; gap: 20rpx;
}
.avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: rgba(255,255,255,0.25);
  border: 3rpx solid rgba(255,255,255,0.5);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.avatar-text {
  font-size: 36rpx; font-weight: 800; color: white;
}
.header-info {
  display: flex; flex-direction: column; gap: 6rpx;
}
.greeting {
  font-size: 34rpx; font-weight: 700; color: #FFFFFF;
  letter-spacing: 1rpx;
}
.header-sub {
  font-size: 22rpx; color: rgba(255,255,255,0.7);
}
.time-chip {
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 100rpx;
  padding: 10rpx 24rpx;
}
.time-text {
  font-size: 28rpx; font-weight: 700; color: white;
  letter-spacing: 3rpx; font-family: monospace;
}

/* ══ 分区标签 ══ */
.section-label {
  position: relative; z-index: 10;
  font-size: 24rpx; font-weight: 700;
  color: #B09080; letter-spacing: 2rpx;
  padding: 28rpx 40rpx 14rpx;
  text-transform: uppercase;
}

/* ══ 核心功能卡片 ══ */
.main-cards {
  position: relative; z-index: 10;
  display: flex; flex-direction: column;
  gap: 16rpx; padding: 0 32rpx;
}

.main-card {
  display: flex; flex-direction: row; align-items: center;
  gap: 24rpx; padding: 28rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 20rpx rgba(200,90,50,0.07);
}
.card-hover { opacity: 0.88; transform: scale(0.98); }

.main-card-icon {
  width: 88rpx; height: 88rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; flex-shrink: 0;
}
/* 三张卡片各自图标背景色 */
.card-event .main-card-icon  { background: linear-gradient(135deg, #FFF0E8, #FFDECA); }
.card-health .main-card-icon { background: linear-gradient(135deg, #FFF0F5, #FFD6E4); }
.card-call .main-card-icon   { background: linear-gradient(135deg, #EDF5FF, #D0E8FF); }

.main-card-body {
  flex: 1;
  display: flex; flex-direction: column; gap: 6rpx;
}
.main-card-title {
  font-size: 30rpx; font-weight: 700; color: #2A1408;
}
.main-card-sub {
  font-size: 22rpx; color: #B09080;
}
.main-card-arrow {
  font-size: 28rpx; color: rgba(200,140,100,0.5);
}

/* ══ 次级功能卡片 ══ */
.sub-cards {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  gap: 16rpx; padding: 0 32rpx;
}

.sub-card {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 12rpx; padding: 32rpx 0;
  background: #FFFFFF;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
}
.sub-card-hover { background: #FFF5F0; }

.sub-card-icon { font-size: 44rpx; }
.sub-card-title {
  font-size: 22rpx; font-weight: 600; color: #5A3020;
  text-align: center;
}

/* ══ 底部标签栏 ══ */
.tab-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  height: 120rpx; z-index: 100;
  background: rgba(255,252,248,0.96);
  border-top: 1rpx solid rgba(255,160,120,0.15);
  box-shadow: 0 -4rpx 20rpx rgba(200,90,50,0.08);
  display: flex; flex-direction: row;
}
.tab-item {
  flex: 1; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 6rpx;
}
.tab-hover { background: #FFF0E8; }
.tab-icon { font-size: 38rpx; line-height: 1; }
.tab-text {
  font-size: 22rpx; font-weight: 600; color: #7A5040;
}

/* ══ 报警遮罩 ══ */
.alert-mask {
  position: fixed; inset: 0;
  background: rgba(20,8,2,0.5);
  z-index: 200;
}

/* ══ 报警弹窗 ══ */
.alert-box {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 580rpx; z-index: 201;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 52rpx 44rpx 44rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column;
  align-items: center; gap: 16rpx;
  box-shadow: 0 24rpx 64rpx rgba(200,50,30,0.25),
              0 0 0 2rpx rgba(255,100,60,0.2);
}
.alert-icon-wrap {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #FFF3EE; border: 4rpx solid #FFD0BC;
  display: flex; align-items: center; justify-content: center;
}
.alert-icon { font-size: 50rpx; }
.alert-title {
  font-size: 40rpx; font-weight: 800; color: #C0392B;
  letter-spacing: 2rpx;
}
.alert-content {
  font-size: 26rpx; color: #6A4030; line-height: 1.7;
  text-align: center;
}
.alert-btn {
  width: 100%; height: 88rpx; margin-top: 8rpx;
  background: linear-gradient(90deg, #FF9A76, #FF5A30);
  border-radius: 44rpx;
  display: flex; flex-direction: row;
  align-items: center; justify-content: center; gap: 12rpx;
  box-shadow: 0 10rpx 28rpx rgba(255,90,48,0.38);
}
.alert-btn:active { opacity: 0.85; }
.alert-btn-text {
  font-size: 30rpx; font-weight: 700; color: white; letter-spacing: 3rpx;
}
.alert-btn-arrow { font-size: 30rpx; color: rgba(255,255,255,0.8); }
