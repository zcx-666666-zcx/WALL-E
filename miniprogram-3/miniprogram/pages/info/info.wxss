/* pages/info/info.wxss */
.container1 {
  height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  background: #002544;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  opacity: 0.75;
}
.container2 {
  margin: 40rpx 30rpx;
  position: relative;
  z-index: 2;
}

#call_info,
#element_info,
#AI_info,
#drive_info,
#command_info,
#write_info,
#Star_info {
  margin: 25rpx 0;
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.85), rgba(250, 250, 250, 0.8));
  border-radius: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 37, 68, 0.1);
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

#call_info:active,
#element_info:active,
#AI_info:active,
#drive_info:active,
#command_info:active,
#write_info:active,
#Star_info:active {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 30rpx rgba(0, 37, 68, 0.2);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(240, 248, 255, 0.9));
}

#call_info text,
#element_info text,
#AI_info text,
#drive_info text,
#command_info text,
#write_info text,
#Star_info text {
  font-size: 26rpx;
  font-weight: 400;
  color: #888;
}

/* 为不同项目添加不同的左侧边框颜色 */
#call_info {
  border-left: 8rpx solid #1890ff;
}

#element_info {
  border-left: 8rpx solid #52c41a;
}

#AI_info {
  border-left: 8rpx solid #fa8c16;
}

#drive_info {
  border-left: 8rpx solid #722ed1;
}

#command_info {
  border-left: 8rpx solid #eb2f96;
}

#write_info {
  border-left: 8rpx solid #13c2c2;
}

#Star_info {
  border-left: 8rpx solid #fadb14;
}