<view class="root">

<image class="bg-image" src="{{image_ip1}}" mode="scaleToFill"></image>
<view class="bg-overlay"></view>
<view class="orb orb-1"></view>
<view class="orb orb-2"></view>

<!-- 顶部品牌 -->
<view class="brand-area">
  <view class="brand-logo">
    <text class="logo-heart">♡</text>
  </view>
  <view class="brand-text">
    <text class="brand-name">智能陪伴</text>
    <text class="brand-sub">机器人管理平台</text>
  </view>
</view>

<!-- 登录卡片 -->
<view class="card">
  <view class="card-header">
    <text class="card-title">欢迎回来</text>
    <text class="card-sub">请登录您的账户继续使用</text>
  </view>

  <view class="field-group">
    <text class="field-label">用户名</text>
    <view class="field-wrap">
      <text class="field-icon">👤</text>
      <input
        class="field-input"
        type="text"
        placeholder="请输入用户名"
        placeholder-class="field-ph"
        bindinput="login_usernameInput"
      />
    </view>
  </view>

  <view class="field-group">
    <text class="field-label">密码</text>
    <view class="field-wrap">
      <text class="field-icon">🔒</text>
      <input
        class="field-input"
        type="safe-password"
        password="{{true}}"
        placeholder="请输入密码"
        placeholder-class="field-ph"
        bindinput="login_passwordInput"
      />
    </view>
  </view>

  <view class="btn-primary" bind:tap="Gologin">
    <text class="btn-primary-text">立即登录</text>
    <text class="btn-arrow">→</text>
  </view>

  <view class="divider">
    <view class="divider-line"></view>
    <text class="divider-text">还没有账号？</text>
    <view class="divider-line"></view>
  </view>

  <navigator class="btn-ghost" url="/pages/registion/registion" hover-class="btn-ghost-hover">
    <text class="btn-ghost-text">注册新账号</text>
  </navigator>
</view>

<view class="tags-row">
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">健康监测</text>
  </view>
  <view class="tag-sep"></view>
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">AI 陪聊</text>
  </view>
  <view class="tag-sep"></view>
  <view class="tag-item">
    <view class="tag-dot"></view>
    <text class="tag-label">远程监护</text>
  </view>
</view>

<view class="footer">
  <text class="footer-text">郑州轻工业大学 · 吊炸天团队</text>
  <navigator url="/pages/menu/menu">11111111111111</navigator>
</view>


</view>
