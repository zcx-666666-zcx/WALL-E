/* pages/call/call.wxss */

/* ══ 根容器 ══ */
.root {
  min-height: 100vh;
  width: 100%;
  background: #e9e3df;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

/* ══ 顶部背景 ══ */
.top-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 360rpx;
  background: linear-gradient(160deg, #FF9A76 0%, #FF6040 60%, #E84020 100%);
  z-index: 0;
  border-radius: 0 0 56rpx 56rpx;
}
.orb {
  position: fixed; border-radius: 50%;
  pointer-events: none; z-index: 1;
}
.orb-1 {
  width: 360rpx; height: 360rpx;
  top: -100rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255,220,180,0.2) 0%, transparent 70%);
}
.orb-2 {
  width: 280rpx; height: 280rpx;
  top: 160rpx; left: -60rpx;
  background: radial-gradient(circle, rgba(255,160,100,0.12) 0%, transparent 70%);
}

/* ══ 顶部标题 ══ */
.header {
  position: relative; z-index: 10;
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
  padding: 88rpx 40rpx 28rpx;
}
.header-left { display: flex; flex-direction: column; gap: 6rpx; }
.header-title { font-size: 44rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 2rpx; }
.header-sub { font-size: 22rpx; color: rgba(255,255,255,0.65); }

/* 连接状态胶囊 */
.status-chip {
  display: flex; flex-direction: row; align-items: center; gap: 8rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 100rpx; padding: 10rpx 22rpx;
}
.status-chip-off { background: rgba(255,255,255,0.1); }
.status-chip-on  { background: rgba(100,220,150,0.2); border-color: rgba(100,220,150,0.4); }

.status-chip-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
}
.status-chip-off .status-chip-dot { background: rgba(255,255,255,0.5); }
.status-chip-on  .status-chip-dot { background: #A8FFCA; }

.status-chip-text { font-size: 22rpx; color: rgba(255,255,255,0.9); }

/* ══ 视频区域 ══ */
.video-section {
  position: relative; z-index: 10;
  margin: 0 32rpx;
  border-radius: 28rpx; overflow: hidden;
  height: 420rpx;
  background: #1A100A;
  box-shadow: 0 8rpx 32rpx rgba(20,8,2,0.3);
  border: 1rpx solid rgba(255,160,120,0.15);
}

/* 远端主画面 */
.video-main {
  width: 100%; height: 100%;
  position: relative;
}
.video-el {
  width: 100%; height: 100%;
  display: block;
}
/* 底部渐变遮罩 */
.video-overlay {
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 160rpx;
  background: linear-gradient(transparent, rgba(20,8,2,0.65));
  pointer-events: none;
}
/* 视频标签 */
.video-label {
  position: absolute; bottom: 22rpx; left: 22rpx;
  display: flex; flex-direction: row; align-items: center; gap: 8rpx;
  background: rgba(0,0,0,0.35);
  border-radius: 100rpx; padding: 8rpx 18rpx;
}
.label-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #A8FFCA;
}
.label-text { font-size: 22rpx; color: rgba(255,255,255,0.9); font-weight: 600; }

/* 占位提示 */
.video-placeholder {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 12rpx;
  background: #1A100A;
}
.placeholder-icon { font-size: 60rpx; opacity: 0.4; }
.placeholder-text { font-size: 24rpx; color: rgba(255,160,100,0.45); }

/* 本地画中画 */
.video-pip {
  position: absolute;
  bottom: 22rpx; right: 22rpx;
  width: 160rpx; height: 120rpx;
  border-radius: 16rpx; overflow: hidden;
  border: 2rpx solid rgba(255,255,255,0.3);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
  background: #2A1808;
}
.pip-label {
  position: absolute; bottom: 8rpx; left: 10rpx;
  font-size: 18rpx; color: rgba(255,255,255,0.7);
}
.pip-placeholder {
  background: #2A1808;
}
.placeholder-icon-sm { font-size: 36rpx; opacity: 0.35; }

/* ══ 分区标签 ══ */
.section-label {
  position: relative; z-index: 10;
  font-size: 24rpx; font-weight: 700; color: #B09080;
  letter-spacing: 2rpx; padding: 28rpx 40rpx 12rpx;
  text-transform: uppercase;
}

/* ══ 控制面板 ══ */
.control-card {
  position: relative; z-index: 10;
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.06);
  display: flex; flex-direction: column; gap: 24rpx;
}

/* 输入字段 */
.field-group { display: flex; flex-direction: column; gap: 10rpx; }
.field-label { font-size: 24rpx; font-weight: 600; color: #6A4030; }
.field-wrap {
  display: flex; flex-direction: row; align-items: center;
  height: 84rpx;
  background: #FFFAF7;
  border: 1rpx solid rgba(255,160,120,0.25);
  border-radius: 18rpx;
  padding: 0 24rpx; gap: 16rpx; box-sizing: border-box;
}
.field-icon { font-size: 28rpx; flex-shrink: 0; opacity: 0.6; }
.field-input {
  flex: 1; height: 100%;
  font-size: 28rpx; color: #3A2010; background: transparent;
}
.field-ph { color: rgba(180,140,120,0.6); font-size: 26rpx; }

/* 按钮组 */
.btn-row {
  display: flex; flex-direction: row; gap: 16rpx;
}
.ctrl-btn {
  flex: 1; height: 88rpx !important;
  border-radius: 18rpx !important;
  border: none !important;
  display: flex; flex-direction: row;
  align-items: center; justify-content: center; gap: 10rpx;
  font-weight: 700 !important;
  padding: 0 !important; margin: 0 !important;
}
.ctrl-btn-icon { font-size: 28rpx; }
.ctrl-btn-text { font-size: 26rpx; font-weight: 700; }

.btn-join {
  background: #FFF0E8 !important;
  color: #C06030 !important;
  border: 1rpx solid rgba(220,120,80,0.2) !important;
}
.btn-join .ctrl-btn-text { color: #C06030; }

.btn-call {
  background: linear-gradient(90deg, #FF9A76, #FF6040) !important;
  color: white !important;
  box-shadow: 0 6rpx 20rpx rgba(255,96,64,0.3) !important;
}
.btn-call .ctrl-btn-text { color: white; }

.btn-disabled {
  background: #EDE8E4 !important;
  box-shadow: none !important;
}
.btn-disabled .ctrl-btn-text { color: #B0A098; }

/* 状态栏 */
.status-bar {
  display: flex; flex-direction: row; align-items: center; gap: 10rpx;
  background: #FFF8F5;
  border: 1rpx solid rgba(255,160,120,0.15);
  border-radius: 14rpx; padding: 18rpx 20rpx;
}
.status-bar-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%; flex-shrink: 0;
}
.status-bar-dot-off { background: #D0B0A0; }
.status-bar-dot-on  { background: #5AB060; }
.status-bar-text { font-size: 24rpx; color: #7A5040; flex: 1; }

/* 连接信息 */
.conn-info {
  display: flex; flex-direction: column; gap: 10rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid rgba(255,160,120,0.1);
}
.conn-row {
  display: flex; flex-direction: row;
  align-items: center; justify-content: space-between;
}
.conn-label { font-size: 22rpx; color: #B09080; }
.conn-val   { font-size: 22rpx; font-weight: 500; color: #5A3020; }

/* ══ 日志卡片 ══ */
.log-card {
  position: relative; z-index: 10;
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255,160,120,0.12);
  box-shadow: 0 4rpx 16rpx rgba(200,90,50,0.05);
}
.log-scroll {
  height: 240rpx;
}
.log-item {
  display: flex; flex-direction: row; gap: 12rpx;
  margin-bottom: 10rpx; align-items: flex-start;
}
.log-time {
  font-size: 20rpx; color: #C4A898;
  flex-shrink: 0; font-family: monospace;
  margin-top: 2rpx;
}
.log-msg { font-size: 22rpx; color: #5A3820; line-height: 1.6; flex: 1; }
