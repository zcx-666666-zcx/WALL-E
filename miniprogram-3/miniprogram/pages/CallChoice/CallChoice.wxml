<!-- pages/CallChoice/CallChoice.wxml -->
<view class="container">
  
  <!-- 标题 -->
  <view class="header">
    <text class="title">AIoT设备通话</text>
  </view>
  
  <!-- 联系人选择 -->
  <view class="contact-section">
    <view 
      class="contact-selector {{selectedContactName ? 'has-contact' : ''}}"
      bindtap="toggleContactList"
    >
      <text class="contact-text">
        {{selectedContactName ? '呼叫: ' + selectedContactName : '点击选择AIoT设备'}}
      </text>
      <text class="arrow">▼</text>
    </view>
    
    <!-- 联系人列表 -->
    <view 
      wx:if="{{showContactList}}" 
      class="contact-list"
    >
      <view 
        wx:for="{{contacts}}" 
        wx:key="index"
        class="contact-item"
        data-index="{{index}}"
        bindtap="selectContact"
      >
        <text class="contact-name">{{item.name}}</text>
        <text class="contact-ip">{{item.ip}}</text>
      </view>
    </view>
  </view>
  
  <!-- 本地Camera预览区域 -->
  <view wx:if="{{pageStatus === 'inVideoCall'}}" class="camera-section">
    <view class="video-container">
      <!-- 本地摄像头 -->
      <view class="local-camera">
        <camera
          device-position="front"
          flash="off"
          binderror="onCameraError"
          bindstop="onCameraStop"
          bindinitdone="onCameraInitDone"
          style="width: 100%; height: 300rpx;"
        >
          <view class="camera-overlay">
            <text class="status-text">
              {{cameraLoaded ? '本地画面' : '初始化中...'}}
            </text>
          </view>
        </camera>
      </view>
      
      <!-- 接收到的远程画面 -->
      <view class="remote-video">
        <view class="video-placeholder" wx:if="{{!currentVideoFrame}}">
          <text class="placeholder-text">等待设备画面...</text>
        </view>
        <image 
          wx:if="{{currentVideoFrame}}" 
          src="data:image/jpeg;base64,{{currentVideoFrame}}"
          mode="aspectFill"
          class="video-frame"
        />
        <view class="video-overlay">
          <text class="status-text">设备画面</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 语音通话状态显示 -->
  <view wx:if="{{pageStatus === 'inAudioCall'}}" class="audio-section">
    <view class="audio-icon">
      <view class="audio-wave">
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
        <view class="wave-bar"></view>
      </view>
    </view>
    <text class="audio-text">语音通话中...</text>
    <text class="audio-info">发送: {{debugInfo.sentAudio}} 接收: {{debugInfo.receivedAudio}}</text>
  </view>
  
  <!-- 控制按钮区域 -->
  <view class="control-section">
    <!-- 视频通话按钮 -->
    <button
      class="control-btn video-btn {{pageStatus === 'inVideoCall' ? 'active' : ''}}"
      bindtap="onVideoButtonTap"
    >
      {{buttonTexts.video}}
    </button>
    
    <!-- 语音通话按钮 -->
    <button
      class="control-btn audio-btn {{pageStatus === 'inAudioCall' ? 'active' : ''}}"
      bindtap="onAudioButtonTap"
    >
      {{buttonTexts.audio}}
    </button>
    
    <!-- 挂断按钮（仅在通话中显示） -->
    <button
      wx:if="{{pageStatus !== 'ready'}}"
      class="control-btn stop-btn"
      bindtap="onStopButtonTap"
    >
      {{buttonTexts.stop}}
    </button>
  </view>
  
  <!-- 调试信息 -->
  <view wx:if="{{pageStatus !== 'ready'}}" class="debug-section">
    <view class="debug-item">
      <text class="debug-label">连接状态:</text>
      <text class="debug-value {{wsConnected ? 'connected' : 'disconnected'}}">
        {{wsConnected ? '已连接' : '未连接'}}
      </text>
    </view>
    <view class="debug-item" wx:if="{{pageStatus === 'inVideoCall'}}">
      <text class="debug-label">视频帧:</text>
      <text class="debug-value">发送 {{debugInfo.sentFrames}} | 接收 {{debugInfo.receivedFrames}}</text>
    </view>
    <view class="debug-item" wx:if="{{pageStatus === 'inAudioCall'}}">
      <text class="debug-label">音频包:</text>
      <text class="debug-value">发送 {{debugInfo.sentAudio}} | 接收 {{debugInfo.receivedAudio}}</text>
    </view>
  </view>
  
  <!-- 状态提示 -->
  <view class="hint-section">
    <text wx:if="{{pageStatus === 'ready'}}" class="hint-text">
      请选择要连接的AIoT设备
    </text>
    <text wx:if="{{pageStatus === 'inVideoCall' && !cameraLoaded}}" class="hint-text">
      正在初始化本地摄像头...
    </text>
  </view>
  
</view>