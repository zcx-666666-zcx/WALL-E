/* 全局页面 —— 与项目完全统一 */
.page-container {
  height: 100vh;
  width: 100%;
  position: relative;
  background: #746e63;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 背景图 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  opacity: 0.75;
}

/* 表单卡片 —— 强化对比 */
.form-card {
  position: relative;
  z-index: 2;
  background: #ffffff;
  border-radius: 10rpx;
  padding: 44rpx 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,0.15); /* 更强阴影 → 卡片悬浮感 */
  max-height: 90vh;
  overflow-y: auto;
}

/* 标题 */
.form-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c261e;
  text-align: center;
  margin-bottom: 48rpx;
  letter-spacing: 3rpx;
}

/* 表单项 —— 拉大间距，视觉分组更清晰 */
.form-section {
  margin-bottom: 40rpx; /* 增加间距，强化区块对比 */
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c261e;
  margin-bottom: 20rpx;
}

/* 输入框 —— 更强内阴影、更干净 */
.text-input{
  width: 100%;
  height: 60rpx;
  background: #f9f9f9;
  border-radius: 5rpx;
  padding: 0 20rpx;
  font-size: 29rpx;
  border: 1rpx solid #cecece;
  box-sizing: border-box;
  line-height: 1.2;
  display: flex;
  align-items: center;
}
.textarea {
  width: 100%;
  background: #f9f9f9;
  border-radius: 5rpx;
  padding: 18rpx;
  font-size: 29rpx;
  border: 1rpx solid #cecece;
  box-sizing: border-box;
}

.textarea {
  min-height: 180rpx;
}

/* 选择器 */
.picker {
  width: 100%;
}

.picker-display {
  background: #f9f9f9;
  border-radius: 5rpx;
  padding: 28rpx 30rpx;
  font-size: 29rpx;
  color: #444;
  border: 1rpx solid #cecece;
}

/* 优先级选项 —— 强化选中对比 */
.priority-container {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.priority-option {
  flex: 1;
  height: 84rpx;
  background: #f1f1f1;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  color: #666;
}

.priority-option.active {
  background: #E2A975;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(226, 169, 117, 0.3);
}

/* 按钮组 —— 视觉权重拉开 */
.button-container {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.button {
  flex: 1;
  height: 92rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

/* 主按钮：强对比 */
.save-button {
  background: #E2A975;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(226, 169, 117, 0.35);
}

/* 次按钮：弱对比 */
.back-button {
  background: #eeeeee;
  color: #444;
}

.back-button navigator {
  color: inherit;
}