<view class="page-container">
  <view class="form-card">
    <view class="form-title">添加新事件</view>
    
    <view class="form-section">
      <view class="section-label">事件名称</view>
      <input class="text-input" type="text" placeholder="请输入事件名称" value="{{eventName}}" bindinput="event_name_input"/>
    </view>
    
    <view class="form-section">
      <view class="section-label">事件提醒日期</view>
      <picker class="picker" mode="date" value="{{eventDate}}" bindchange="eventDateInput">
        <view class="picker-display">{{eventDate || '请选择日期'}}</view>
      </picker>
    </view>
    
    <view class="form-section">
      <view class="section-label">重复提醒</view>
      <picker class="picker" range="{{repeatOptions}}" value="{{repeatIndex}}" bindchange="onRepeatChange">
        <view class="picker-display">{{repeatOptions[repeatIndex] || '请选择重复周期'}}</view>
      </picker>
    </view>
    
    <view class="form-section">
      <view class="section-label">事件时间</view>
      <picker class="picker" mode="time" value="{{eventTime}}" bindchange="eventTimeInput">
        <view class="picker-display">{{eventTime || '请选择时间'}}</view>
      </picker>
    </view>
    
    <view class="form-section">
      <view class="section-label">优先级</view>
      <view class="priority-container">
        <view class="priority-option {{priorityIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="onPriorityChange">低</view>
        <view class="priority-option {{priorityIndex === 1 ? 'active' : ''}}" data-index="1" bindtap="onPriorityChange">中</view>
        <view class="priority-option {{priorityIndex === 2 ? 'active' : ''}}" data-index="2" bindtap="onPriorityChange">高</view>
      </view>
      <view><text>若多个事件同时提醒，将按照优先级依次提醒</text></view>
    </view>

    <view class="form-section">
      <view class="section-label">绑定设备号</view>
      <input class="text-input" type="text" placeholder="请输入设备号" value="{{machines}}" bindinput="machines_input"/>
    </view>
    
    <view class="form-section">
      <view class="section-label">事件描述</view>
      <textarea class="textarea" placeholder="请输入事件描述" value="{{description}}" bindinput="event_info_input"/>
      <view><text>实际提醒话语</text></view>
    </view>
    
    <view class="button-container">
      <view class="button save-button" bindtap="save_event">保存事件</view>
      <view class="button back-button">
        <navigator url="/pages/elementList/elementList" open-type="navigateBack">返回</navigator>
      </view>
    </view>
  </view>
</view>