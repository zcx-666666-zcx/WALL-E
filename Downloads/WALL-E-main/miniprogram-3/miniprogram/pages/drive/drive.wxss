/* pages/drive/drive.wxss */
.container1{
  height: 100vh;
  width: 100%;
  position: relative;
  overflow: hidden;
  background-color: #002544
}
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  opacity: 0.75;
}

/* 远程遥控标题优化 */
.UP{
  height: 10%;
  width: 80%;
  margin: 5% 10%;
  z-index: 2;
  position: absolute;
  display: flex;
  text-align: center;
  align-items: center;
  justify-content: center;
  font-size: 65rpx;
  font-weight: 600;
  color: white;
  backdrop-filter: blur(10rpx);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 连接状态优化 */
#connect{
  height: 6%;
  width: 40%;
  top: 15%;
  left: 30%;
  position: absolute;
  z-index: 2;
  display: flex;
  font-size: 34rpx;
  text-align: center;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
  border-radius: 16rpx;
  color: rgb(255, 0, 0);
  font-weight: 500;
}

/* 视频区域优化 */
#vedio{
  top: 20%;
  left: 3%;
  height: 28%;
  width: 94%;
  position: absolute;
  z-index: 2;
  background: linear-gradient(135deg, rgba(60, 60, 60, 0.9), rgba(40, 40, 40, 0.95));
  backdrop-filter: blur(12rpx);
  display: flex;
  font-size: 36rpx;
  text-align: center;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
}
.container2 {
  position: absolute;
  top: 55%;
  left: 10%;
  width: 80%;
  height: 400rpx;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
  gap: 15rpx;
  grid-template-areas: 
    "up go down"
    "left . right"
    ". back .";
}

#left {
  grid-area: left;
  background: rgba(60,60,60,0.6);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 25rpx rgba(60,60,60,0.4);
  transition: all 0.2s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

#left::after {
  content: "◀";
  font-size: 60rpx;
  color: white;
  font-weight: bold;
}

#right {
  grid-area: right;
  background: rgba(60,60,60,0.6);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 25rpx rgba(60,60,60,0.4);
  transition: all 0.2s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

#right::after {
  content: "▶";
  font-size: 60rpx;
  color: white;
  font-weight: bold;
}

#up {
  grid-area: up;
  background: rgba(60,60,60,0.3);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 25rpx rgba(60,60,60,0.2);
  transition: all 0.2s ease;
  width: 50%;
  height: 100%; /* 高度改为100% */
  justify-self: center;
  align-self: center;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

#up::after {
  content: "抬头";
  font-size: 32rpx;
  color: rgb(61, 61, 61);
  font-weight: bold;
}

#down {
  grid-area: down;
  background: rgba(60,60,60,0.3);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 25rpx rgba(60,60,60,0.2);
  transition: all 0.2s ease;
  width: 50%;
  height: 100%; /* 高度改为100% */
  justify-self: center;
  align-self: center;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

#down::after {
  content: "低头";
  font-size: 32rpx;
  color: rgb(61, 61, 61);
  font-weight: bold;
}

#go {
  grid-area: go;
  background: rgba(60,60,60,0.6);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 25rpx rgba(60,60,60,0.4);
  transition: all 0.2s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

#go::after {
  content: "▲";
  font-size: 60rpx;
  color: white;
  font-weight: bold;
}

#back {
  grid-area: back;
  background: rgba(60,60,60,0.6);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 25rpx rgba(60,60,60,0.4);
  transition: all 0.2s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

#back::after {
  content: "▼";
  font-size: 60rpx;
  color: white;
  font-weight: bold;
}

/* 按钮点击效果 */
#left:active, #right:active, #up:active, #down:active, #go:active, #back:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.3);
  filter: brightness(0.9);
}

#left:active::after, #right:active::after, #up:active::after, #down:active::after, #go:active::after, #back:active::after {
  opacity: 0.8;
}

